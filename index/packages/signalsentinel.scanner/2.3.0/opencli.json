  "opencli": "0.1-draft",
  "info": {
    "title": "Signal Sentinel Scanner",
    "version": "2.3.0",
    "description": "Fast, deterministic, offline-capable first-pass security aid for MCP servers and Agent Skill authors. 26 security rules aligned with OWASP Agentic AI Top 10 (ASI) and OWASP Agentic Skills Top 10 (AST). v2.3 adds: .sentinel-suppressions.json for accepted-risk management, confidence-aware triage (--min-confidence / --triage), scan history and diff (sentinel-scan diff), non-MCP endpoint detection (SS-INFO-001), per-environment scoping, explicit scope disclosure in every report, and pre-commit hook integrations."
  },
