  "info": {
    "title": "cachemix - inspect and manage cache keys on a Redis-compatible server.",
    "version": "1.0.0",
    "description": "dotnet-cachemix — a terminal client for Cachemix. Lists, inspects and nukes cache keys on a Redis, Garnet or Valkey server straight from the command line, with no running web host required. Install as a .NET global tool and invoke as 'cachemix'."
  },
