  "info": {
    "title": "b4-roslyn — ByteAid Roslyn MCP server for .NET solutions",
    "version": "0.3.0",
    "description": "MCP (stdio) server that exposes Roslyn-powered tools to work with .NET solutions: persistent in-memory semantic models, solution pre-compilation, navigation, refactoring, diagnostics, file edits, builds and test execution. Install as a dotnet tool and start with: b4-roslyn start (or 'b4 roslyn start' via the b4 dispatcher)"
  },
