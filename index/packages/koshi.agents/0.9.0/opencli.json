{
  "opencli": "0.1-draft",
  "info": {
    "title": "koshi-agents",
    "version": "0.9.0.0"
  },
  "commands": [
    {
      "name": "doctor",
      "options": [
        {
          "name": "--client",
          "aliases": [
            "-c"
          ],
          "arguments": [
            {
              "name": "CLIENT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Which client to inspect: claude, copilot, both.  Default: both.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--quick",
          "description": "Skip the live-ping handshake — static  file/PATH/config checks only.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--scope",
          "aliases": [
            "-s"
          ],
          "arguments": [
            {
              "name": "SCOPE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Scope: user or repo. Default: user.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--verbose",
          "description": "Print JSON-RPC handshake details, tool list, and  stderr tail for failed pings.",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Diagnose Koshi installation and persona wiring.  Read-only.",
      "hidden": false,
      "examples": [
        "doctor"
      ]
    },
    {
      "name": "install",
      "options": [
        {
          "name": "--client",
          "aliases": [
            "-c"
          ],
          "arguments": [
            {
              "name": "CLIENT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Target client: claude, copilot, both. Default: both.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--dry-run",
          "description": "Show what would be written without touching the  filesystem.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--force",
          "description": "Overwrite existing files without prompting.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--no-mcp",
          "description": "Skip registering the koshi MCP server in the  client's mcp config. Personas are still installed; you must register  koshi-mcp yourself.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--quiet",
          "aliases": [
            "-q"
          ],
          "description": "Suppress the Next Steps banner (for scripted  installs).",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--scope",
          "aliases": [
            "-s"
          ],
          "arguments": [
            {
              "name": "SCOPE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Install scope: user (~ home dir) or repo (current  repo). Default: user.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--show-next-steps",
          "description": "Print the Next Steps banner without installing or  modifying anything. Useful for re-reading the post-install guidance after the  fact.",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Install personas into a client's agents directory.",
      "hidden": false,
      "examples": [
        "install --client claude",
        "install --client copilot --scope repo",
        "install --client both --dry-run"
      ]
    },
    {
      "name": "list",
      "options": [
        {
          "name": "--client",
          "aliases": [
            "-c"
          ],
          "arguments": [
            {
              "name": "CLIENT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Filter by client: claude, copilot, both. Default:  both.",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "List all available Koshi personas.",
      "hidden": false,
      "examples": [
        "list",
        "list --client claude"
      ]
    },
    {
      "name": "show",
      "options": [
        {
          "name": "--client",
          "aliases": [
            "-c"
          ],
          "arguments": [
            {
              "name": "CLIENT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Which client's variant to show: claude, copilot.  Default: claude.",
          "recursive": false,
          "hidden": false
        }
      ],
      "arguments": [
        {
          "name": "PERSONA",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "description": "The persona name (e.g. koshi-librarian).",
          "hidden": false,
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String"
            }
          ]
        }
      ],
      "description": "Show the contents of a persona (front-matter +  body).",
      "hidden": false,
      "examples": [
        "show koshi-librarian",
        "show koshi-orchestrator --client copilot"
      ]
    },
    {
      "name": "uninstall",
      "options": [
        {
          "name": "--client",
          "aliases": [
            "-c"
          ],
          "arguments": [
            {
              "name": "CLIENT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Target client: claude, copilot, both. Default: both.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--dry-run",
          "description": "Show what would be removed without touching the  filesystem.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--scope",
          "aliases": [
            "-s"
          ],
          "arguments": [
            {
              "name": "SCOPE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Scope: user or repo. Default: user.",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Remove Koshi personas from a client's agents  directory.",
      "hidden": false,
      "examples": [
        "uninstall --client claude"
      ]
    }
  ],
  "x-inspectra": {
    "artifactSource": "lib-native",
    "cliFramework": "Spectre.Console.Cli"
  }
}
