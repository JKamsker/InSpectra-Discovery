          "name": "create-transcription",
          "description": "Transcribe audio\nConverts a pre-recorded audio file into text using Fireworks AI ASR models. Use the default base URL for `whisper-v3`; override the client base URI to `https://audio-turbo.api.fireworks.ai/v1` when using `whisper-v3-turbo`.\n",
          "options": [
            {
              "name": "--file",
              "recursive": false,
              "hidden": false,
              "description": "Audio file to transcribe. Fireworks also accepts a public URL in this form field, but the generated SDK models the documented file upload path as a binary field.",
