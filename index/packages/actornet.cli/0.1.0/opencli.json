  "commands": [
    {
      "name": "bench",
      "options": [
        {
          "name": "--actors",
          "aliases": [
            "-a"
          ],
          "arguments": [
            {
              "name": "COUNT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.Int32"
                }
              ]
            }
          ],
          "description": "How many actors to spread the messages over. Default  8.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--messages",
          "aliases": [
            "-n"
          ],
          "arguments": [
            {
              "name": "COUNT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.Int32"
                }
              ]
            }
          ],
          "description": "Messages to send. Default 1000000.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--senders",
          "aliases": [
            "-s"
          ],
          "arguments": [
            {
              "name": "COUNT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.Int32"
                }
              ]
            }
          ],
          "description": "Concurrent sending tasks. Default: one per core.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--warmup",
          "arguments": [
            {
              "name": "COUNT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.Int32"
                }
              ]
            }
          ],
          "description": "Messages to send before timing, to let the JIT settle. Default 50000.",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Measure local message throughput, counting only messages  actually handled.",
      "hidden": false,
      "examples": [
        "bench -n 2000000 -a 16"
      ]
    },
    {
      "name": "cluster",
      "options": [
        {
          "name": "--cluster",
          "description": "Join a cluster with no seeds of its own - what the  first node of a cluster needs, since it has nobody to join.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--data",
          "arguments": [
            {
              "name": "DIRECTORY",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Persist state and events under this directory instead  of in memory, so they survive a restart.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--host",
          "arguments": [
            {
              "name": "HOST",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Address to bind. Default 127.0.0.1.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--idle-timeout",
          "arguments": [
            {
              "name": "SECONDS",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.Int32"
                }
              ]
            }
          ],
          "description": "Deactivate an actor after this many seconds without  messages. Default 300.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--node-id",
          "arguments": [
            {
              "name": "ID",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "This node's identity in the cluster. Defaults to  a name derived from the machine and process.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--port",
          "aliases": [
            "-p"
          ],
          "arguments": [
            {
              "name": "PORT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.Int32"
                }
              ]
            }
          ],
          "description": "Port to bind. 0 picks a free one. Default 9000.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--seed",
          "arguments": [
            {
              "name": "HOST:PORT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String[]"
                }
              ]
            }
          ],
          "description": "A cluster seed to join. Repeat for several. Supplying  any seed turns clustering on.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--verbose",
          "aliases": [
            "-v"
          ],
          "description": "Log the runtime's own activity at debug level.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--watch",
          "description": "Keep printing the member table as it changes.",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Join a cluster and show the member table and key  placement.",
      "hidden": false,
      "examples": [
        "cluster --port 9002 --seed 127.0.0.1:9001 --watch"
      ]
    },
