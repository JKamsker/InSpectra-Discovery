  "info": {
    "title": "rulealize",
    "version": "0.10.0",
    "description": "Runs a Rulealize rule set from a command line: restore the plugins it requires, report what a plugin folder provides, and check, list the legal inputs, apply one, or walk it interactively — a rule set that holds other rule sets included."
  },
