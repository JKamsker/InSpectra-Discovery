          ]
        },
        {
          "name": "sync",
          "hidden": false,
          "description": "Downloads the Kosmera skill package for an AI provider, pinned by version,\nand writes it into that tool's own location in the current project so the AI\ntool knows how to build Kosmera apps.\nThe resolved version is recorded in .kosmera/skills.lock.json,\nso re-running the command is a no-op until the version or the package changes.\nSynced files are managed content: a file you have edited by hand is replaced\nby the pinned version, with a warning naming it. Use --dry-run to see that\nbefore it happens. A file the new version no longer ships is never deleted\nif you have edited it.",
          "options": [
            {
              "name": "--provider",
              "recursive": false,
              "hidden": false,
              "description": "AI provider to sync for (default: claude)",
              "aliases": [
                "-p"
              ],
              "arguments": [
                {
                  "name": "ID",
                  "required": false,
                  "arity": {
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              ]
            },
