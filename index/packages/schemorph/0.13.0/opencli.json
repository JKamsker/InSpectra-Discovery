  "commands": [
    {
      "name": "apply",
      "hidden": false,
      "description": "execute the change plan and record it in the history ledger",
      "options": [
        {
          "name": "--url",
          "recursive": false,
          "hidden": false,
          "description": "target database (required)",
          "arguments": [
            {
              "name": "CONNECTION_STRING",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              }
            }
          ]
        },
        {
          "name": "--schema",
          "recursive": false,
          "hidden": false,
          "description": "desired-state SQL directory (required)",
          "arguments": [
            {
              "name": "DIR",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              }
            }
          ]
        },
        {
          "name": "--migrations",
          "recursive": false,
          "hidden": false,
          "description": "versioned migration scripts (V####__description.sql)",
          "arguments": [
            {
              "name": "DIR",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              }
            }
          ]
        },
        {
          "name": "--allow-destructive",
          "recursive": false,
          "hidden": false,
          "description": "apply destructive changes too"
        },
        {
          "name": "--expect-plan",
          "recursive": false,
          "hidden": false,
          "description": "apply only if the computed plan matches this\nfingerprint (printed by diff); mismatch = abort",
          "arguments": [
            {
              "name": "HASH",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              }
            }
          ]
        },
        {
          "name": "--format",
          "recursive": false,
          "hidden": false,
          "description": "output form (default: text on a terminal,\njson when stdout is redirected)\nif an apply fails:\nre-run it — every stage converges on re-run, and there is no repair\ncommand to remember. What the database looks like after a partial\napply, and how to read the ledger without misreading it:\nhttps://github.com/iyulab/Schemorph/blob/main/docs/failure-semantics.md\nconnection:\n--url can be omitted when the SCHEMORPH_URL environment variable is set\n(preferred: keeps credentials out of shell history). Passwords are\nredacted from every output channel.\nExit codes: 0 = success / no changes, 1 = error, 2 = diff found pending changes.\nErrors are a typed envelope on stderr (docs/errors.md).",
          "arguments": [
            {
              "name": "FORMAT",
              "required": false,
              "arity": {
                "minimum": 0,
                "maximum": 1
              }
            }
          ]
        }
      ]
