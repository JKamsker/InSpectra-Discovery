  "info": {
    "title": "schemorph — declarative, SQL-first schema management",
    "version": "0.13.0",
    "description": "Declarative, SQL-first schema management for SQL Server: diff for structure, idempotent re-definition for programmable objects, versioned migrations for data — one plan, one history ledger, agent-friendly output."
  },
