{
  "opencli": "0.1-draft",
  "info": {
    "title": "snipdeck-importer",
    "version": "1.0"
  },
  "commands": [
    {
      "name": "snipcommand",
      "options": [
        {
          "name": "--allow-duplicates",
          "description": "Import snips even if one with the same title and  command already exists.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--cli",
          "arguments": [
            {
              "name": "NAME",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Force every imported snip into this CLI, overriding  auto-detection.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--into",
          "arguments": [
            {
              "name": "NAME",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Fallback CLI for snips whose CLI could not be  confidently auto-detected.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--no-share-parameters",
          "description": "Keep every parameter on its snip instead of promoting  duplicates to CLI-shared parameters.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--store",
          "arguments": [
            {
              "name": "PATH",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Target Snipdeck store file. Defaults to the desktop  app's store.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--write",
          "description": "Apply the changes. Without this flag the importer only previews (dry-run).",
          "recursive": false,
          "hidden": false
        }
      ],
      "arguments": [
        {
          "name": "path",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "description": "Path to the source export to import.",
          "hidden": false,
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String"
            }
          ]
        }
      ],
      "description": "Import command snippets from a SnipCommand export.",
      "hidden": false,
      "examples": [
        "snipcommand snipcommand.db",
        "snipcommand snipcommand.db --write",
        "snipcommand snipcommand.db --store store.json --cli mpt-app"
      ]
    }
  ],
  "x-inspectra": {
    "artifactSource": "lib-native",
    "cliFramework": "Spectre.Console.Cli"
  }
}
