  "info": {
    "title": "optunasharp",
    "version": "1.0.0",
    "description": "The OptunaSharp command-line tool — the port of the `optuna` CLI (optuna/cli.py) on System.CommandLine + YamlDotNet. Create/inspect studies and ask/tell trials against journal-file, SQLite (RDBStorage) and Redis storages from the shell, with byte-identical value/json/table output. Part of the SciSharp STACK."
  },
