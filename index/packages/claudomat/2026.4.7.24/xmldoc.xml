      <Option Short="" Long="exclude-branch" Value="NULL" Required="false" Kind="vector" ClrType="System.String[]">
        <Description>Skip pr when branch matches a glob; default includes renovate/* (repeatable)</Description>
      </Option>
      <Option Short="" Long="max-retries" Value="NULL" Required="false" Kind="scalar" ClrType="System.Int32">
        <Description>Maximum retry attempts on rate limit</Description>
      </Option>
      <Option Short="" Long="max-turns" Value="NULL" Required="false" Kind="scalar" ClrType="System.Nullable`1[[System.Int32, System.Private.CoreLib, Version=10.0.0.0, Culture=neutral, 
PublicKeyToken=7cec85d7bea7798e]]">
        <Description>Maximum number of agentic turns</Description>
      </Option>
      <Option Short="" Long="mcp-feed" Value="NULL" Required="false" Kind="scalar" ClrType="System.String">
        <Description>NuGet v3 feed index URL for MCP server packages (tag: mcp-server)</Description>
      </Option>
      <Option Short="" Long="mcp-feed-pat" Value="NULL" Required="false" Kind="scalar" ClrType="System.String">
        <Description>PAT for --mcp-feed (optional if SYSTEM_ACCESSTOKEN or AZURE_DEVOPS_PAT is set)</Description>
      </Option>
      <Option Short="" Long="model" Value="NULL" Required="false" Kind="scalar" ClrType="System.String">
        <Description>Claude model to use (e.g. sonnet, opus)</Description>
      </Option>
      <Option Short="" Long="no-default-branch-excludes" Value="NULL" Required="false" Kind="flag" ClrType="System.Boolean">
        <Description>Do not add renovate/*; only --exclude-branch patterns apply</Description>
      </Option>
      <Option Short="" Long="output-json" Value="NULL" Required="false" Kind="scalar" ClrType="System.String">
        <Description>Write a JSON session report to this file path</Description>
      </Option>
      <Option Short="" Long="permission" Value="NULL" Required="false" Kind="scalar" ClrType="System.String">
        <Description>Claude permission mode: omit for auto; use 'unsafe' for --dangerously-skip-permissions</Description>
      </Option>
      <Option Short="" Long="source-branch" Value="NULL" Required="false" Kind="scalar" ClrType="System.String">
        <Description>Override branch for exclude check (default: CI env or git HEAD)</Description>
      </Option>
      <Option Short="" Long="stream-verbose" Value="NULL" Required="false" Kind="flag" ClrType="System.Boolean">
        <Description>Include stream-json event type lines in live output</Description>
      </Option>
      <Option Short="" Long="timeout" Value="NULL" Required="false" Kind="scalar" ClrType="System.Int32">
        <Description>Task timeout in minutes (0 = no timeout, default 30)</Description>
      </Option>
