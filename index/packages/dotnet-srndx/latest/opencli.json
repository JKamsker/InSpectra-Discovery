  "opencli": "0.1-draft",
  "info": {
    "title": "srndx",
    "version": "0.1.0",
    "description": "A fully-managed (no native dependency), AOT-friendly semantic + keyword search CLI for code and text. Combines Model2Vec static embeddings, Hnsw.Net vector search, BM25, and fastText language identification."
  },
  "x-inspectra": {
    "artifactSource": "crawled-from-help",
    "generator": "InSpectra.Gen",
    "helpDocumentCount": 8,
    "cliParsedDescription": "srndx - offline semantic search over local files and git history. Pure managed: FastText.Net (language ID) + Model2Vec.Net (embeddings) + Hnsw.Net (vector index). No native dependency, no GPU, no cloud."
  },
