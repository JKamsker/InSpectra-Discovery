                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Base URL of the installation, e.g.  https://archive.example.com. Defaults to $SACONSOLE_URL.",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Sign in through the device grant and print the session as  shell exports.",
      "hidden": false
