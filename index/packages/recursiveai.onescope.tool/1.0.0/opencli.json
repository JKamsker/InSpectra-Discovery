{
  "opencli": "0.1-draft",
  "info": {
    "title": "onescope",
    "version": "1.0.0",
    "description": "onescope: a viewer for the Recursive AI family's deterministic libraries. Scrub a replay, inspect any entity, capture frames, and drive it all over MCP."
  },
  "x-inspectra": {
    "artifactSource": "crawled-from-help",
    "generator": "InSpectra.Gen",
    "helpDocumentCount": 1,
    "cliParsedDescription": "Start the shell"
  },
  "commands": [],
  "options": [
    {
      "name": "--module",
      "recursive": false,
      "hidden": false,
      "description": "load a module assembly (repeatable); needed for any file format a module owns",
      "arguments": [
        {
          "name": "DLL",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--headless",
      "recursive": false,
      "hidden": false,
      "description": "no window: render offscreen (captures work the same)"
    },
    {
      "name": "--live",
      "recursive": false,
      "hidden": false,
      "description": "serve the operations over a Unix socket (MCP, one JSON-RPC message per line)"
    },
    {
      "name": "--run",
      "recursive": false,
      "hidden": false,
      "description": "run an operation after opening (repeatable); each result is printed as JSON",
      "arguments": [
        {
          "name": "OP",
          "required": false,
          "arity": {
            "minimum": 0,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--size",
      "recursive": false,
      "hidden": false,
      "description": "window or capture size (default 1280x720)",
      "arguments": [
        {
          "name": "WXH",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--backend",
      "recursive": false,
      "hidden": false,
      "description": "window system and display (x11 or wayland), as in onegame",
      "arguments": [
        {
          "name": "NAME",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--artifacts",
      "recursive": false,
      "hidden": false,
      "description": "where captures go (default ./artifacts)",
      "arguments": [
        {
          "name": "DIR",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--keyframe",
      "recursive": false,
      "hidden": false,
      "description": "keyframe interval in steps (default 64)",
      "arguments": [
        {
          "name": "N",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--no-wait",
      "recursive": false,
      "hidden": false,
      "description": "with --run: exit after the operations instead of staying open (headless only)"
    }
  ]
}
