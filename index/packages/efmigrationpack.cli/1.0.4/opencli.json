  "info": {
    "title": "dotnet-ef-pack",
    "version": "1.0.4",
    "description": "Command-line tool for packing EF Core migrations: \"dotnet ef-pack pack\" packs migrations into one migration and archives the originals in a zip; \"dotnet ef-pack unpack\" restores them. Works with EF Core 6 and later; projects reference the EfMigrationPack runtime package."
  },
