{
  "opencli": "0.1-draft",
  "info": {
    "title": "wow-migrate",
    "version": "10.0.53-beta",
    "description": "Web-free SQL migrator CLI (`wow-migrate`) over the WoW Two backend SDK bespoke migrator — status, apply, new, promote, rollback, verify (+--repair) against a Postgres database."
  },
  "x-inspectra": {
    "artifactSource": "startup-hook",
    "generator": "InSpectra.Gen",
    "hookCapture": {
      "cliFramework": "System.CommandLine",
      "frameworkVersion": "2.0.9.0",
      "systemCommandLineVersion": "2.0.9.0",
      "patchTarget": "Parse-postfix ()"
    },
    "cliFramework": "System.CommandLine",
    "cliParsedDescription": "wow-migrate — web-free SQL migrator CLI."
  },
  "options": [
    {
      "name": "--help",
      "recursive": true,
      "hidden": false,
      "description": "Show help and usage information",
      "aliases": [
        "-h",
        "/h",
        "-?",
        "/?"
      ]
    },
    {
      "name": "--version",
      "recursive": false,
      "hidden": false,
      "description": "Show version information"
    },
    {
      "name": "--connection",
      "recursive": true,
      "hidden": false,
      "description": "Postgres connection (else WOW_MIGRATE_DB_CONNECTION, else localhost/postgres).",
      "arguments": [
        {
          "name": "CONNECTION",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "type": "String"
        }
      ]
    },
    {
      "name": "--sql-dir",
      "recursive": true,
      "hidden": false,
      "description": "Migrations dir (else WOW_MIGRATE_SQL_DIR, else auto-discovered).",
      "arguments": [
        {
          "name": "SQL_DIR",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "type": "String"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "status",
      "description": "Show applied / pending / drift / orphaned."
    },
    {
      "name": "apply",
      "description": "Ensure the DB exists, then apply pending migrations."
    },
    {
      "name": "rollback",
      "description": "Roll back the latest migration (or down to ordinal N). Dev only.",
      "options": [
        {
          "name": "--to",
          "recursive": false,
          "hidden": false,
          "description": "Roll back down to this ordinal (else just the latest).",
          "arguments": [
            {
              "name": "TO",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "type": "Int32"
            }
          ]
        },
        {
          "name": "--i-understand-this-is",
          "recursive": false,
          "hidden": false,
          "description": "Confirm the target database name (must match the connection's database).",
          "arguments": [
            {
              "name": "I_UNDERSTAND_THIS_IS",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "type": "String"
            }
          ]
        },
        {
          "name": "--force",
          "recursive": false,
          "hidden": false,
          "description": "Skip the interactive [y/N] confirmation prompt. [default: False]",
          "arguments": [
            {
              "name": "FORCE",
              "required": false,
              "arity": {
                "minimum": 0,
                "maximum": 1
              },
              "type": "Boolean"
            }
          ]
        }
      ]
    },
    {
      "name": "verify",
      "description": "Exit 1 on checksum drift; --repair re-records edited checksums.",
      "options": [
        {
          "name": "--repair",
          "recursive": false,
          "hidden": false,
          "description": "Re-record edited checksums instead of failing on drift. [default: False]",
          "arguments": [
            {
              "name": "REPAIR",
              "required": false,
              "arity": {
                "minimum": 0,
                "maximum": 1
              },
              "type": "Boolean"
            }
          ]
        },
        {
          "name": "--i-understand-this-is",
          "recursive": false,
          "hidden": false,
          "description": "Confirm the target database name (required with --repair).",
          "arguments": [
            {
              "name": "I_UNDERSTAND_THIS_IS",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "type": "String"
            }
          ]
        },
        {
          "name": "--force",
          "recursive": false,
          "hidden": false,
          "description": "Skip the interactive [y/N] confirmation prompt when repairing. [default: False]",
          "arguments": [
            {
              "name": "FORCE",
              "required": false,
              "arity": {
                "minimum": 0,
                "maximum": 1
              },
              "type": "Boolean"
            }
          ]
        }
      ]
    },
    {
      "name": "new",
      "description": "Scaffold Dev/<name>.sql.",
      "arguments": [
        {
          "name": "NAME",
          "description": "The draft migration name (slugified).",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "type": "String"
        }
      ]
    },
    {
      "name": "promote",
      "description": "Promote Dev/*.sql → numbered NNN-name/{Apply,Rollback}.sql."
    }
  ]
}
