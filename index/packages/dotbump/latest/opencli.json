                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "The global.json file to update. Defaults to\n\u0060./global.json\u0060.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--logfile",
          "arguments": [
            {
              "name": "VALUE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "The file to send the log output to.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--output",
          "aliases": [
            "-o"
          ],
          "arguments": [
            {
              "name": "VALUE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Output file name. The name of the file to write the\nresult to. The output format is json.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--security-only",
          "aliases": [
            "-s"
          ],
          "description": "Only bump the version if the new release is a security\nrelease. Defaults to false.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--type",
          "aliases": [
            "-t"
          ],
          "arguments": [
            {
              "name": "VALUE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.Nullable\u003CDotBump.Commands.BumpType\u003E"
                }
              ]
            }
          ],
          "description": "The bump type. Defaults to \u0060minor\u0060.\nAvailable options are \u0060minor\u0060 and \u0060patch\u0060.",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Bump the global.json SDK version. Use the \n\u0027minor\u0027 type option to bump the SDK to the latest minor or patch \nversion for the current major version. Use the \u0027patch\u0027 type option to \nbump the SDK to the latest patch version for the current minor version. ",
      "hidden": false,
      "examples": [
        "sdk",
        "sdk --type patch",
        "sdk --file ./other/global.json --output bump-sdk-report.json",
        "sdk --security-only true --debug true --logfile bump-sdk-log.txt"
      ]
    },
