      ],
      "description": "Bump the local .NET tools versions. Use the \n\u0027minor\u0027 type option to bump the tools to the latest minor or patch \nversions for the current major version. Use the \u0027patch\u0027 type option to\nbump the tools to the latest patch version for the current minor version. ",
      "hidden": false,
      "examples": [
