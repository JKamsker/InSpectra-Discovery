    "version": "1.0"
  },
  "commands": [
    {
      "name": "sdk",
      "options": [
        {
          "name": "--debug",
          "description": "Enable debug logging for troubleshooting. Includes\nresponse data.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--file",
          "aliases": [
            "-f"
          ],
          "arguments": [
            {
