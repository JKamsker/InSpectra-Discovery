  "info": {
    "title": "bamboo-sign Scan and code-sign Windows binaries via Bamboo Deploy",
    "version": "1.1.0",
    "description": "Scan and code-sign Windows .exe and .msi files from dotnet publish, MSBuild, or any build script via the Bamboo Deploy API. No certificate or hardware token to manage."
  },
