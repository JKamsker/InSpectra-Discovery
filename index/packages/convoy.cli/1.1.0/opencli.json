      "name": "migrate",
      "hidden": false,
      "description": "Run migrations across the fleet\nrollback --tenant ID --target M Rollback a tenant to a target migration\npending  --tenant ID            Show pending migrations for a tenant",
      "options": [
        {
          "name": "--dry-run",
          "recursive": false,
          "hidden": false,
          "description": "Simulate without touching databases"
        },
        {
