              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Adds an extension to the current project.",
          "hidden": false,
          "examples": [
            "extension add jwt",
            "extension add cache --provider redis"
          ]
        },
        {
          "name": "list",
          "description": "Lists all available extensions and their installation  status.",
          "hidden": false,
          "examples": [
            "extension list"
          ]
