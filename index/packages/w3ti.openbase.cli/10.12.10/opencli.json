    {
      "name": "build",
      "options": [
        {
          "name": "--configuration",
          "aliases": [
            "-c"
          ],
          "arguments": [
            {
              "name": "CONFIGURATION",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Build configuration (Debug or Release)",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--no-restore",
          "description": "Skip dotnet restore",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Restores, builds and tests the project.",
      "hidden": false,
      "examples": [
        "build",
        "build --configuration Release",
        "build --no-restore"
      ]
    },
    {
      "name": "extension",
      "commands": [
        {
          "name": "add",
          "options": [
            {
              "name": "--provider",
              "aliases": [
                "-p"
              ],
              "arguments": [
