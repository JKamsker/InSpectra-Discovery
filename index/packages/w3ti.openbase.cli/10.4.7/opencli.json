{
  "opencli": "0.1-draft",
  "info": {
    "title": "openbase",
    "version": "1.0"
  },
  "commands": [
    {
      "name": "help",
      "description": "Exibe a ajuda para os comandos do OpenBase",
      "hidden": false
    },
    {
      "name": "install",
      "description": "Instala o ecossistema de templates OpenBase.",
      "hidden": false,
      "examples": [
        "install"
      ]
    },
    {
      "name": "new",
      "options": [
        {
          "name": "--name",
          "aliases": [
            "-n"
          ],
          "arguments": [
            {
              "name": "NOME",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "O nome do projeto a ser criado",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--template",
          "aliases": [
            "-s"
          ],
          "arguments": [
            {
              "name": "TEMPLATE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "O nome do template [sqlserver|pgsql]",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--type",
          "aliases": [
            "-t"
          ],
          "arguments": [
            {
              "name": "TIPO",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "O tipo do template [api]",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Cria um novo projeto baseado em um template.",
      "hidden": false,
      "examples": [
        "new --type api --template sqlserver --name MeuProjeto"
      ]
    },
    {
      "name": "scaffold",
      "options": [
        {
          "name": "--entity",
          "aliases": [
            "-e"
          ],
          "arguments": [
            {
              "name": "ENTIDADE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "O nome da entidade a ser gerada (PascalCase, ex:  Produto)",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--namespace",
          "aliases": [
            "-n"
          ],
          "arguments": [
            {
              "name": "NAMESPACE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Namespace raiz do projeto (detectado automaticamente  se omitido)",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Gera todas as camadas da arquitetura para uma entidade.",
      "hidden": false,
      "examples": [
        "scaffold --entity Produto"
      ]
    },
    {
      "name": "update",
      "description": "Sincroniza e atualiza todos os templates OpenBase.",
      "hidden": false
    },
    {
      "name": "version",
      "description": "Exibe as versões da CLI e do template do OpenBase",
      "hidden": false
    }
  ],
  "x-inspectra": {
    "artifactSource": "lib-native",
    "cliFramework": "Spectre.Console.Cli"
  }
}
