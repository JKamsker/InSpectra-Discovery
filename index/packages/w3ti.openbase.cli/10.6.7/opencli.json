        {
          "name": "restore",
          "options": [
            {
              "name": "--type",
              "arguments": [
                {
                  "name": "VALUE",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Componente a restaurar: cli, sqlserver, postgres",
              "recursive": false,
              "hidden": false
            }
          ],
          "arguments": [
            {
              "name": "version",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "Versão para restaurar (ex: 10.5.9)",
              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
