{
  "opencli": "0.1-draft",
  "info": {
    "title": "SbomCheck",
    "version": "1.0"
  },
  "arguments": [
    {
      "name": "bom.json",
      "required": true,
      "arity": {
        "minimum": 1,
        "maximum": 1
      },
      "description": "Path to CycloneDX bom.json",
      "hidden": false,
      "metadata": [
        {
          "name": "ClrType",
          "value": "System.String"
        }
      ]
    }
  ],
  "options": [
    {
      "name": "--allowed-licenses",
      "arguments": [
        {
          "name": "LICENSES",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String[]"
            }
          ]
        }
      ],
      "description": "Comma-separated SPDX license IDs that are permitted (e.g.  MIT,Apache-2.0). Any other license is a violation. Can be specified multiple  times.",
      "recursive": false,
      "hidden": false
    },
    {
      "name": "--forbidden-components",
      "arguments": [
        {
          "name": "COMPONENTS",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String[]"
            }
          ]
        }
      ],
      "description": "Comma-separated package names to forbid (case-insensitive, e.g. log4net,Newtonsoft.Json). Can be specified multiple times.",
      "recursive": false,
      "hidden": false
    },
    {
      "name": "--forbidden-licenses",
      "arguments": [
        {
          "name": "LICENSES",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String[]"
            }
          ]
        }
      ],
      "description": "Comma-separated SPDX license IDs to forbid (e.g.  GPL-3.0,AGPL-3.0). Can be specified multiple times.",
      "recursive": false,
      "hidden": false
    },
    {
      "name": "--ignore-components",
      "arguments": [
        {
          "name": "COMPONENTS",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String[]"
            }
          ]
        }
      ],
      "description": "Components to exclude from all policy checks. Supports  wildcards (e.g. Microsoft*) and version ranges. Takes priority over forbidden  rules. Can be specified multiple times.",
      "recursive": false,
      "hidden": false
    },
    {
      "name": "--plain",
      "description": "Plain ASCII output — no colors, no box-drawing  characters. Recommended for CI log files.",
      "recursive": false,
      "hidden": false
    }
  ],
  "commands": [],
  "x-inspectra": {
    "artifactSource": "lib-native",
    "cliFramework": "Spectre.Console.Cli"
  }
}
