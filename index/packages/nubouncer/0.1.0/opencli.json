{
  "opencli": "0.1-draft",
  "info": {
    "title": "NuBouncer: checks NuGet packages' ID at the door.",
    "version": "0.1.0",
    "description": "Stops AI coding agents adding NuGet packages that don't exist or look dodgy. Checks packages before they're installed: does it exist, is it brand new, barely downloaded, spoofing a trusted prefix, deprecated or vulnerable?"
  },
  "x-inspectra": {
    "artifactSource": "crawled-from-help",
    "generator": "InSpectra.Gen",
    "helpDocumentCount": 1
  },
  "commands": [
    {
      "name": "check",
      "hidden": false,
      "description": "Check one package",
      "options": [
        {
          "name": "--version",
          "recursive": false,
          "hidden": false,
          "arguments": [
            {
              "name": "VERSION",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              }
            }
          ]
        }
      ],
      "arguments": [
        {
          "name": "PACKAGEID",
          "required": true,
          "hidden": false,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "hook",
      "hidden": false,
      "description": "Run as a Claude Code PreToolUse hook (reads JSON on stdin)"
    },
    {
      "name": "scan",
      "hidden": false,
      "description": "Check every package in the project files under a folder",
      "arguments": [
        {
          "name": "FOLDER",
          "required": false,
          "hidden": false,
          "arity": {
            "minimum": 0,
            "maximum": 1
          }
        }
      ]
    }
  ]
}
