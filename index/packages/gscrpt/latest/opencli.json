  "opencli": "0.1-draft",
  "info": {
    "title": "gscript 2.0.0-alpha.3 - self-healing, cross-platform git-push + dev-ops ceremony",
    "version": "2.0.0-alpha.3",
    "description": "Self-healing, cross-platform git-push + dev-ops ceremony tool. Content-shape preflight gates (trailing-null, file-size, structured-file parse, markdown shrinkage, leak-check), localmd PAT auth, stale-lock recovery, retry-on-collision, per-step CI watch, post-deploy probes. The C# successor to the gscript PowerShell module."
  },
