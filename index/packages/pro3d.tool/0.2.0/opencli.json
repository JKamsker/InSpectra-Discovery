      "name": "kdtree",
      "description": "Validate OPC directories and generate KdTrees.",
      "options": [
        {
          "name": "--verbose",
          "recursive": false,
          "hidden": false,
          "description": "Prints all messages to standard output."
        },
        {
          "name": "--forcekdtreerebuild",
          "recursive": false,
          "hidden": false,
          "description": "Forces rebuild and overwrites existing kd-trees"
        },
        {
          "name": "--ignore-master-kd-tree",
          "recursive": false,
          "hidden": false,
          "description": "Ignores master kd-trees and load or creates per-patch kd-trees as well as the lazy kd-tree cache"
        },
        {
          "name": "--generatedds",
          "recursive": false,
          "hidden": false,
          "description": "Generate DDS"
