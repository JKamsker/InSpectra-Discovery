        {
          "name": "--overwritedds",
          "recursive": false,
          "hidden": false,
          "description": "Overwrite DDS"
        },
        {
          "name": "--degrees-of-parallelism",
          "recursive": false,
          "hidden": false,
          "description": "Degree of paralellism (0 for single threaded)",
          "arguments": [
            {
              "name": "DEGREES_OF_PARALLELISM",
              "required": false,
              "arity": {
                "minimum": 0,
                "maximum": 1
