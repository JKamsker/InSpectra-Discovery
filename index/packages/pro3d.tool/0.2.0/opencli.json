  "info": {
    "title": "pro3d-tool",
    "version": "0.2.0",
    "description": "Command line tools for PRo3D data: OPC validation and KdTree generation, per-pixel illumination geometry, and unprojecting image pixel coordinates onto a shape model."
  },
  "x-inspectra": {
    "artifactSource": "startup-hook",
    "generator": "InSpectra.Gen",
    "hookCapture": {
      "cliFramework": "CommandLineParser",
      "frameworkVersion": "2.9.1.0",
      "patchTarget": "Parser.ParseArguments"
    },
    "cliFramework": "CommandLineParser"
  },
  "commands": [
