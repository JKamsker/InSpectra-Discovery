  "opencli": "0.1-draft",
  "info": {
    "title": "spm",
    "version": "0.3.6",
    "description": "spm (Skill and Plugin Manager) — a CLI, interactive REPL, and MCP server that installs AI agent skills from Git catalogs into Claude Code, OpenAI Codex CLI, Google Antigravity, Cursor, Cline, Devin, Aider, GitHub Copilot, Hermes, OpenClaw, opencode, Sourcegraph Amp, and Pi. Find a skill by intent with ranked search, deploy it across every detected agent at once, or run spm as an MCP server so an agent can search and install skills itself."
  },
