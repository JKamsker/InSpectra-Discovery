{
  "opencli": "0.1-draft",
  "info": {
    "title": "classdojo-export",
    "version": "1.0"
  },
  "commands": [
    {
      "name": "export-multimedia",
      "options": [
        {
          "name": "--end",
          "arguments": [
            {
              "name": "DATE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Only include posts on or before this date (e.g.  2026-05-20).",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--export-folder",
          "arguments": [
            {
              "name": "FOLDER",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Folder to write downloaded media and metadata into.  Created if missing.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--force-login",
          "description": "Ignore any cached session and force an interactive  login.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--start",
          "arguments": [
            {
              "name": "DATE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Only include posts on or after this date (e.g.  2026-01-01).",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--student-id",
          "arguments": [
            {
              "name": "STUDENT_ID",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "The ClassDojo student ID whose story feed should be  exported.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--title",
          "arguments": [
            {
              "name": "TITLE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Heading to show on the feed page instead of the  default \"ClassDojo Story Feed\".",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Downloads all media and post metadata from a  student's ClassDojo story feed.",
      "hidden": false,
      "examples": [
        "export-multimedia --student-id abc123studentId --export-folder  C:\\exports\\alex"
      ]
    }
  ],
  "x-inspectra": {
    "artifactSource": "lib-native",
    "cliFramework": "Spectre.Console.Cli"
  }
}
