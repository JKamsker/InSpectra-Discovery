  "info": {
    "title": "dotnet inngest runs the Inngest dev server for an app built with the Inngest .NET SDK.",
    "version": "1.0.0",
    "description": "The dotnet inngest command for the Inngest .NET SDK: dotnet inngest dev downloads the Inngest CLI, checks its SHA-256 and runs the Inngest dev server for the app in the current folder."
  },
