  "opencli": "0.1-draft",
  "info": {
    "title": "tracon - Tracon management CLI",
    "version": "1.0.0-preview.2",
    "description": "The `tracon` global tool: applies pending migrations as a separate deployment step (`migrate`, `migrate status`), reports read-only whether this build can still read the stored state before an upgrade (`state-check`), reads the health endpoint through Tracon.Client (`health`), runs an eval suite as a CI quality gate (`eval`), and writes the gate skill a coding agent loads before it touches a Tracon surface (`agent-skill`)."
  },
