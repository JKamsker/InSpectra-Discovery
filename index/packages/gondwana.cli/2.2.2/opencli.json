          ]
        },
        {
          "name": "pack",
          "options": [
            {
              "name": "--append",
              "aliases": [
                "-a"
              ],
              "description": "Append to an existing bundle instead of  overwriting it (default: false).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--recurse",
              "aliases": [
                "-r"
              ],
              "description": "Recurse into subdirectories (default: true).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--type",
              "aliases": [
                "-t"
              ],
              "arguments": [
                {
                  "name": "VALUE",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Default asset type for files whose type cannot be  inferred (default: Misc).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--type-map",
              "aliases": [
                "-m"
              ],
              "arguments": [
                {
                  "name": "VALUE",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Path to a JSON file that maps asset types to file  extensions. Defaults to 'gondwana-asset-types.json' in the current  directory or next to the executable.",
              "recursive": false,
              "hidden": false
            }
          ],
          "arguments": [
            {
              "name": "source",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "The source directory containing files to pack.",
              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            },
            {
              "name": "output",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "The output asset file path (e.g. game.assets or  game.gaf).",
              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Pack a directory of files into an asset bundle.",
          "hidden": false,
          "examples": [
            "assets pack ./Assets ./game.assets"
          ]
        }
      ],
      "description": "Pack, inspect, and extract Gondwana asset files.",
      "hidden": false
    },
