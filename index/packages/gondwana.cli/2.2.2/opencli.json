              "recursive": false,
              "hidden": false
            }
          ],
          "arguments": [
            {
              "name": "file",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "The asset file to generate keys from.",
              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
