            {
              "name": "file",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "The asset file to inspect.",
              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
