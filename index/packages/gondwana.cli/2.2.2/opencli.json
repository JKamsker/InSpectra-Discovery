  "commands": [
    {
      "name": "assets",
      "commands": [
        {
          "name": "extract",
          "options": [
            {
              "name": "--overwrite",
              "description": "Overwrite existing files.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--type",
              "aliases": [
                "-t"
              ],
              "arguments": [
                {
                  "name": "VALUE",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Extract only assets of the specified type (e.g.  Image, Audio).",
              "recursive": false,
              "hidden": false
            }
          ],
          "arguments": [
            {
              "name": "file",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "The asset file to extract.",
              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            },
            {
              "name": "output",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "The output directory to extract assets into.",
              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Extract all assets from a bundle to a directory.",
          "hidden": false,
          "examples": [
            "assets extract ./game.assets ./Extracted"
          ]
        },
        {
