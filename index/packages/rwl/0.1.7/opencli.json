{
  "opencli": "0.1-draft",
  "info": {
    "title": "rwl",
    "version": "2.0.0"
  },
  "commands": [
    {
      "name": "add-task",
      "arguments": [
        {
          "name": "title",
          "required": false,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "description": "Task title (will prompt if not provided)",
          "hidden": false,
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String"
            }
          ]
        }
      ],
      "description": "Add a single task to TASKS.md",
      "hidden": false,
      "examples": [
        "add-task",
        "add-task Fix auth module"
      ]
    },
    {
      "name": "compact",
      "arguments": [
        {
          "name": "keep",
          "required": false,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "description": "Number of recent iterations to keep (default: 5)",
          "hidden": false,
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.Int32"
            }
          ]
        }
      ],
      "description": "Compact PROGRESS.md to reduce size",
      "hidden": false,
      "examples": [
        "compact",
        "compact 10"
      ]
    },
    {
      "name": "doctor",
      "description": "Verify loop setup and report issues",
      "hidden": false
    },
    {
      "name": "health",
      "description": "Run convergence and guardrail checks",
      "hidden": false
    },
    {
      "name": "init",
      "options": [
        {
          "name": "--no-agents",
          "description": "Skip installing agent profiles",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--no-hooks",
          "description": "Skip installing git hooks",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--no-instructions",
          "description": "Skip installing instructions",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--no-skills",
          "description": "Skip installing skills",
          "recursive": false,
          "hidden": false
        }
      ],
      "description": "Initialize Ralph Wiggum Loop in current project",
      "hidden": false,
      "examples": [
        "init",
        "init --no-hooks"
      ]
    },
    {
      "name": "plan",
      "description": "Interactive task planner",
      "hidden": false
    },
    {
      "name": "reset",
      "description": "Reset loop state (tasks, progress, or all)",
      "hidden": false
    },
    {
      "name": "run",
      "description": "Start the iterative loop",
      "hidden": false
    },
    {
      "name": "run-one",
      "description": "Execute a single loop iteration",
      "hidden": false
    },
    {
      "name": "status",
      "description": "Show task progress dashboard",
      "hidden": false
    },
    {
      "name": "stop",
      "description": "Create stop flag to halt the loop",
      "hidden": false
    }
  ],
  "x-inspectra": {
    "artifactSource": "lib-native",
    "cliFramework": "Spectre.Console.Cli"
  }
}
