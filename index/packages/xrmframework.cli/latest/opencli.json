{
  "opencli": "0.1-draft",
  "info": {
    "title": "xrmframework",
    "version": "1.0"
  },
  "commands": [
    {
      "name": "deploy",
      "commands": [
        {
          "name": "plugins",
          "options": [
            {
              "name": "--dll",
              "arguments": [
                {
                  "name": "PATH",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Assembly net462 du projet plugin à  déployer (plugins, custom APIs, workflows).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--noprompt",
              "aliases": [
                "-n"
              ],
              "description": "Mode silencieux : ignore la confirmation de  connexion (CI/CD).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--on-premise",
              "description": "Cible un CRM On-Premises (défaut : Dataverse  Online).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--project",
              "arguments": [
                {
                  "name": "NAME",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Nom du projet tel que déclaré dans  xrmFramework.config (ex. Plugins).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--project-root",
              "arguments": [
                {
                  "name": "DIR",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Racine du projet contenant le dossier Config/  (défaut : dossier courant).",
              "recursive": false,
              "hidden": false
            }
          ],
          "description": "Déploie une assembly (plugins, custom APIs,  workflows) vers l'environnement sélectionné.",
          "hidden": false,
          "examples": [
            "deploy plugins --dll bin/net8.0/MonProjet.Plugins.dll --project  Plugins"
          ]
        }
      ],
      "description": "Déploiement de composants vers l'environnement  sélectionné (xrmFramework.config).",
      "hidden": false
    },
    {
      "name": "tables",
      "commands": [
        {
          "name": "list",
          "options": [
            {
              "name": "--custom-only",
              "description": "Ne retenir que les tables personnalisées.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--filter",
              "arguments": [
                {
                  "name": "TEXT",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Ne retenir que les tables dont le nom logique ou  le libellé contient ce texte.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--prefix",
              "arguments": [
                {
                  "name": "PREFIX",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Ne retenir que les tables dont le nom logique  commence par ce préfixe (ex. ftp_).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--project-root",
              "arguments": [
                {
                  "name": "DIR",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Racine contenant le dossier Config/ (défaut : recherche en remontant depuis le dossier courant).",
              "recursive": false,
              "hidden": false
            }
          ],
          "description": "Liste les tables de l'environnement  sélectionné, filtrables par préfixe.",
          "hidden": false,
          "examples": [
            "tables list --prefix ftp_"
          ]
        },
        {
          "name": "pull",
          "options": [
            {
              "name": "--noprompt",
              "aliases": [
                "-n"
              ],
              "description": "Mode silencieux : ignore la confirmation  (CI/CD).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--prefix",
              "arguments": [
                {
                  "name": "PREFIX",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Récupère en outre toutes les tables dont le nom logique commence par ce préfixe.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--project-root",
              "arguments": [
                {
                  "name": "DIR",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Racine contenant le dossier Config/ (défaut : recherche en remontant depuis le dossier courant).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--table",
              "aliases": [
                "-t"
              ],
              "arguments": [
                {
                  "name": "NAME",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String[]"
                    }
                  ]
                }
              ],
              "description": "Nom logique d'une table à  récupérer. Option répétable, et accepte une liste  séparée par des virgules. Par défaut : toutes les tables ayant  déjà un fichier .table.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--tables-dir",
              "arguments": [
                {
                  "name": "DIRECTORY",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Répertoire des fichiers .table (défaut : le dossier Definitions du projet Core).",
              "recursive": false,
              "hidden": false
            }
          ],
          "description": "Génère ou met à jour des fichiers  .table depuis les métadonnées de l'environnement (par défaut : ceux déjà présents).",
          "hidden": false,
          "examples": [
            "tables pull",
            "tables pull --table account,ftp_contrat"
          ]
        },
        {
          "name": "sync",
          "options": [
            {
              "name": "--clean",
              "description": "Met Select=false sur les colonnes orphelines et  supprime les .table entièrement générés sans donnée  CRM.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--dll",
              "arguments": [
                {
                  "name": "PATH",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Chemin vers le DLL à analyser (contient des  classes *Definition avec [[EntityDefinition]]).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--tables-dir",
              "arguments": [
                {
                  "name": "DIRECTORY",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Répertoire contenant les fichiers .table  à mettre à jour ou créer.",
              "recursive": false,
              "hidden": false
            }
          ],
          "description": "Synchronise les fichiers .table depuis un assembly  contenant des classes [[EntityDefinition]].",
          "hidden": false,
          "examples": [
            "tables sync --dll bin/MonProjet.dll --tables-dir Definitions"
          ]
        }
      ],
      "description": "Commandes liées aux tables / fichiers .table.",
      "hidden": false
    }
  ],
  "x-inspectra": {
    "artifactSource": "lib-native",
    "cliFramework": "Spectre.Console.Cli"
  }
}
