{
  "opencli": "0.1-draft",
  "info": {
    "title": "xrmframework",
    "version": "1.0"
  },
  "commands": [
    {
      "name": "deploy",
      "commands": [
        {
          "name": "plugins",
          "options": [
            {
              "name": "--dll",
              "arguments": [
                {
                  "name": "PATH",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "net462 assembly of the plugin project to deploy  (plugins, custom APIs, workflows).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--noprompt",
              "aliases": [
                "-n"
              ],
              "description": "Silent mode: skips the connection confirmation  (CI/CD). Also accepts -NoPrompt.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--on-premise",
              "description": "Targets an On-Premises CRM (default: Dataverse  Online).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--project",
              "arguments": [
                {
                  "name": "NAME",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Project name as declared in xrmFramework.config  (e.g. Plugins).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--project-root",
              "arguments": [
                {
                  "name": "DIR",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Project root containing the Config/ folder  (default: current folder).",
              "recursive": false,
              "hidden": false
            }
          ],
          "description": "Deploys an assembly (plugins, custom APIs, workflows)  to the selected environment.",
          "hidden": false,
          "examples": [
            "deploy plugins --dll bin/net8.0/MyProject.Plugins.dll --project  Plugins"
          ]
        }
      ],
      "description": "Deployment of components to the selected environment  (xrmFramework.config).",
      "hidden": false
    },
    {
      "name": "migrate",
      "commands": [
        {
          "name": "sync-tables",
          "options": [
            {
              "name": "--clean",
              "description": "Sets Select=false on orphaned columns and deletes  .table files entirely generated with no CRM data.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--dll",
              "arguments": [
                {
                  "name": "PATH",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Path to the 2.* assembly to analyze (contains  *Definition classes with [[EntityDefinition]]).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--tables-dir",
              "arguments": [
                {
                  "name": "DIRECTORY",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Directory holding the .table and *Definition.cs  files to migrate.",
              "recursive": false,
              "hidden": false
            }
          ],
          "description": "Migrates definitions from XrmFramework 2.* to  3.1+: updates the .table files from a 2.* assembly, then cleans up the  *Definition.cs files. Run once.",
          "hidden": false,
          "examples": [
            "migrate sync-tables --dll bin/MyProject.dll --tables-dir  Definitions"
          ]
        }
      ],
      "description": "One-shot migrations of a project's sources. Run once, then commit.",
      "hidden": false
    },
    {
      "name": "tables",
      "commands": [
        {
          "name": "list",
          "options": [
            {
              "name": "--custom-only",
              "description": "Only keep custom tables.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--filter",
              "arguments": [
                {
                  "name": "TEXT",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Only keep tables whose logical name or label  contains this text.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--prefix",
              "arguments": [
                {
                  "name": "PREFIX",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Only keep tables whose logical name starts with  this prefix (e.g. ftp_).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--project-root",
              "arguments": [
                {
                  "name": "DIR",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Root containing the Config/ folder (default:  search by walking up from the current folder).",
              "recursive": false,
              "hidden": false
            }
          ],
          "description": "Lists the tables of the selected environment,  filterable by prefix.",
          "hidden": false,
          "examples": [
            "tables list --prefix ftp_"
          ]
        },
        {
          "name": "pull",
          "options": [
            {
              "name": "--noprompt",
              "aliases": [
                "-n"
              ],
              "description": "Silent mode: skips the confirmation (CI/CD).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--prefix",
              "arguments": [
                {
                  "name": "PREFIX",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Also retrieves all tables whose logical name  starts with this prefix.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--project-root",
              "arguments": [
                {
                  "name": "DIR",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Root containing the Config/ folder (default:  search by walking up from the current folder).",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--table",
              "aliases": [
                "-t"
              ],
              "arguments": [
                {
                  "name": "NAME",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String[]"
                    }
                  ]
                }
              ],
              "description": "Logical name of a table to retrieve. Repeatable  option, and accepts a comma-separated list. Default: all tables that already  have a .table file.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--tables-dir",
              "arguments": [
                {
                  "name": "DIRECTORY",
                  "required": true,
                  "arity": {
                    "minimum": 1,
                    "maximum": 1
                  },
                  "metadata": [
                    {
                      "name": "ClrType",
                      "value": "System.String"
                    }
                  ]
                }
              ],
              "description": "Directory for the .table files (default: the Core  project's Definitions folder).",
              "recursive": false,
              "hidden": false
            }
          ],
          "description": "Generates or updates .table files from the  environment's metadata (by default: those already present).",
          "hidden": false,
          "examples": [
            "tables pull",
            "tables pull --table account,ftp_contrat"
          ]
        }
      ],
      "description": "Commands related to tables / .table files.",
      "hidden": false
    }
  ],
  "x-inspectra": {
    "artifactSource": "lib-native",
    "cliFramework": "Spectre.Console.Cli"
  }
}
