  "commands": [
    {
      "name": "config",
      "commands": [
        {
          "name": "allow-libs",
          "arguments": [
            {
              "name": "allowed: true|false",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "Wether to allow external dependencies or not.",
              "hidden": false
            }
          ],
          "description": "Allow or disallow external libraries to be loaded.",
          "hidden": false,
          "examples": [
            "config allow-libs true"
          ]
        },
        {
          "name": "open",
          "description": "Opens the app's configuration directory.",
          "hidden": false,
          "examples": [
            "config open"
          ]
        },
        {
          "name": "register-lib",
          "options": [
            {
              "name": "--copy-only",
              "description": "Just copy the assembly into the application's directory (e. g. for plugin updates). This won't register the assembly in  `sources.json`.",
              "recursive": false,
              "hidden": false
            },
            {
              "name": "--register-only",
              "description": "Just registers the assembly into the settings file (e. g. for debugging purposes). This won't copy the assembly into the  application's directory.",
              "recursive": false,
              "hidden": false
            }
          ],
          "arguments": [
            {
              "name": "path",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "description": "Path to the DLL file.",
              "hidden": false,
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Register a new library which is copied to application  directory and registered in `sources.json`.",
          "hidden": false,
          "examples": [
            "config register-lib E:\\my-own-appi-plugin.dll",
            "config register-lib E:\\my-own-appi-plugin.dll --register-only",
            "config register-lib E:\\my-own-appi-plugin.dll --copy-only true"
          ]
        }
      ],
      "description": "Configure Appi.",
      "hidden": false
    },
    {
      "name": "find",
      "options": [
        {
          "name": "--case-sensitive",
          "aliases": [
            "-c"
          ],
          "description": "The query parameter will be case-sensitive.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--group",
          "aliases": [
            "-g"
          ],
          "arguments": [
            {
              "name": "VALUE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Search within a group.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--source",
          "aliases": [
            "-s"
          ],
          "arguments": [
            {
              "name": "VALUE",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Search within a single source.",
          "recursive": false,
          "hidden": false
        }
      ],
      "arguments": [
        {
          "name": "query",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "description": "Search for the given query.",
          "hidden": false,
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String"
            }
          ]
        }
      ],
      "description": "Query all [i](default)[/] or only the specified sources.",
      "hidden": false,
      "examples": [
        "god",
        "god -s poetry",
        "god -g demo",
        "find god",
        "find god --source poetry",
        "find god --group demo"
      ]
    },
    {
      "name": "list",
      "description": "List all sources usable for the [i]find[/] command.",
      "hidden": false,
      "examples": [
        "list"
      ]
    }
