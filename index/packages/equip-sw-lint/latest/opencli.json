{
  "opencli": "0.1-draft",
  "info": {
    "title": "equip-sw-lint",
    "version": "1.0.1",
    "description": "Command-line runner for EquipSwLint analyzers: analyzes C# sources without building, writes SARIF 2.1.0 and HTML, supports a baseline gate."
  },
  "x-inspectra": {
    "artifactSource": "crawled-from-help",
    "generator": "InSpectra.Gen",
    "helpDocumentCount": 1
  },
  "commands": [],
  "options": [
    {
      "name": "--sarif",
      "recursive": false,
      "hidden": false,
      "description": "write SARIF 2.1.0 (open it in the viewer or upload to code scanning)",
      "arguments": [
        {
          "name": "FILE",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--html",
      "recursive": false,
      "hidden": false,
      "description": "write a single-file HTML report",
      "arguments": [
        {
          "name": "FILE",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--baseline",
      "recursive": false,
      "hidden": false,
      "description": "results already in that SARIF are 'unchanged'; only new ones fail the gate",
      "arguments": [
        {
          "name": "SARIF",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--fail-on",
      "recursive": false,
      "hidden": false,
      "description": "warning (default) | error | none   (Shadow rules report as note and never fail)",
      "arguments": [
        {
          "name": "LEVEL",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--ref",
      "recursive": false,
      "hidden": false,
      "description": "extra assemblies to resolve types (vendor SDK DLLs); repeatable",
      "arguments": [
        {
          "name": "FOLDER",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--exclude",
      "recursive": false,
      "hidden": false,
      "description": "skip folders with this name (tests, vendored code); repeatable",
      "arguments": [
        {
          "name": "NAME",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--repo-root",
      "recursive": false,
      "hidden": false,
      "description": "write paths relative to this folder (e.g. the repository root, so GitHub\ncode scanning links to source); fingerprints and baselines are unaffected",
      "arguments": [
        {
          "name": "DIR",
          "required": true,
          "arity": {
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "--lang",
      "recursive": false,
      "hidden": false,
      "description": "message language (default: OS UI language)",
      "arguments": [
        {
          "name": "LANG",
          "required": false,
          "arity": {
            "minimum": 0,
            "maximum": 1
          }
        }
      ]
    }
  ]
}
