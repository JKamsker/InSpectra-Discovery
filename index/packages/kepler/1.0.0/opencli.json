{
  "opencli": "0.1-draft",
  "info": {
    "title": "keplercli",
    "version": "1.0.0",
    "description": "Release automation for multi-project NuGet repositories."
  },
  "x-inspectra": {
    "artifactSource": "startup-hook",
    "generator": "InSpectra.Gen",
    "hookCapture": {
      "cliFramework": "System.CommandLine",
      "frameworkVersion": "2.0.6.0",
      "systemCommandLineVersion": "2.0.6.0",
      "patchTarget": "Parse-postfix ()"
    },
    "cliFramework": "System.CommandLine",
    "cliParsedDescription": "Kepler NuGet release automation"
  },
  "options": [
    {
      "name": "--help",
      "recursive": true,
      "hidden": false,
      "description": "Show help and usage information",
      "aliases": [
        "-h",
        "/h",
        "-?",
        "/?"
      ]
    },
    {
      "name": "--version",
      "recursive": false,
      "hidden": false,
      "description": "Show version information"
    }
  ],
  "commands": [
    {
      "name": "pack",
      "description": "Build packages defined by the release plan."
    },
    {
      "name": "check",
      "description": "Confirm pushed packages are available on the remote NuGet source.",
      "options": [
        {
          "name": "--wait",
          "recursive": false,
          "hidden": false,
          "description": "Wait until every pushed package is visible on the remote source. [default: False]",
          "arguments": [
            {
              "name": "WAIT",
              "required": false,
              "arity": {
                "minimum": 0,
                "maximum": 1
              },
              "type": "Boolean"
            }
          ]
        },
        {
          "name": "--timeout",
          "recursive": false,
          "hidden": false,
          "description": "Maximum wait duration (default: 00:15:00).",
          "arguments": [
            {
              "name": "TIMEOUT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "type": "TimeSpan"
            }
          ]
        },
        {
          "name": "--interval",
          "recursive": false,
          "hidden": false,
          "description": "Delay between checks (default: 00:00:30).",
          "arguments": [
            {
              "name": "INTERVAL",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "type": "TimeSpan"
            }
          ]
        }
      ]
    },
    {
      "name": "init",
      "description": "Prepare the local Kepler workspace."
    },
    {
      "name": "plan",
      "description": "Calculate, validate, and write the release plan.",
      "options": [
        {
          "name": "--dry-run",
          "recursive": false,
          "hidden": false,
          "description": "Calculate and print the release plan without writing changes. [default: False]",
          "arguments": [
            {
              "name": "DRY_RUN",
              "required": false,
              "arity": {
                "minimum": 0,
                "maximum": 1
              },
              "type": "Boolean"
            }
          ]
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish packages generated by pack.",
      "options": [
        {
          "name": "--api-key",
          "recursive": false,
          "hidden": false,
          "description": "NuGet API key.",
          "arguments": [
            {
              "name": "API_KEY",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "type": "String"
            }
          ]
        },
        {
          "name": "--dry-run",
          "recursive": false,
          "hidden": false,
          "description": "Validate and print the publication without pushing packages. [default: False]",
          "arguments": [
            {
              "name": "DRY_RUN",
              "required": false,
              "arity": {
                "minimum": 0,
                "maximum": 1
              },
              "type": "Boolean"
            }
          ]
        }
      ]
    },
    {
      "name": "scan",
      "description": "Scan package projects and synchronize their dependency and remote version state."
    }
