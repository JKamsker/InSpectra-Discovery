    {
      "name": "mcp",
      "description": "Serve the analysis tools to AI agents over MCP (stdio).",
      "hidden": false
    },
    {
      "name": "run",
      "options": [
        {
          "name": "--children",
          "description": "Also capture allocation profiles for child processes,  not just the root.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--correlate",
          "description": "Track per-object allocation provenance (enables  whoalloc on snapshots).",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--experimental-gc-barrier",
          "description": "Experimental: hold the capture GC while taking a  correlated dump.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--include-process",
          "arguments": [
            {
              "name": "GLOB",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String[]"
                }
              ]
            }
          ],
          "description": "Profile only matching executable/entry-DLL filenames.  Repeatable; enables profiling of matching children.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--live",
          "description": "Open a live TUI: heap usage + process tree;  snapshot a process on demand.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--profile",
          "description": "Attach the allocation profiler; capture the exit-time  allocation profile.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--profiler-log",
          "arguments": [
            {
              "name": "LEVEL",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "Sherlock.Core.Collection.ProfilerLogLevel"
                }
              ]
            }
          ],
          "description": "Native profiler log level: trace, info, warning,  error, or off.",
          "recursive": false,
          "hidden": false
        },
        {
          "name": "--snapshot-on",
          "arguments": [
            {
              "name": "EVENT",
              "required": true,
              "arity": {
                "minimum": 1,
                "maximum": 1
              },
              "metadata": [
                {
                  "name": "ClrType",
                  "value": "System.String"
                }
              ]
            }
          ],
          "description": "Capture on exit or another event, e.g.  throw:My.Namespace.Exception.",
          "recursive": false,
          "hidden": false
        }
      ],
      "arguments": [
        {
          "name": "path",
          "required": false,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "description": "Executable or dll to launch (or pass it after  `--`).",
          "hidden": false,
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String"
            }
          ]
        },
        {
          "name": "args",
          "required": false,
          "arity": {
            "minimum": 1,
            "maximum": 1
          },
          "description": "Arguments passed to the launched process.",
          "hidden": false,
          "metadata": [
            {
              "name": "ClrType",
              "value": "System.String[]"
            }
          ]
        }
      ],
      "description": "Run a process to completion, capturing snapshots and  exit-time artifacts.",
      "hidden": false,
      "examples": [
        "run -- ./MyApp.dll arg1",
        "run --correlate --snapshot-on throw:My.App.FatalException --  ./MyApp.dll"
      ]
    },
    {
      "name": "tui",
      "description": "Explore the snapshot library in an interactive  heap-explorer TUI.",
