  "opencli": "0.1-draft",
  "info": {
    "title": "ruledger",
    "version": "1.4.0",
    "description": "Ruledger from a command line: walks a Rulealize rule set and writes down the test design — for every state it visits, which inputs are legal, whether it is final and with what result, and where each legal input leads — and applies one to a later version of the rule set, which is the diff, carrying the choices a person made across it."
  },
