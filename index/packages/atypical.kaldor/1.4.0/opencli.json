{
  "opencli": "0.1-draft",
  "info": {
    "title": "kaldor: intent/code review guard for Claude Code",
    "version": "1.4.0",
    "description": "Intent/code review guard for Claude Code: no agent commit enters the repository without being checked against a declared intent, by a reviewer the agent does not control."
  },
  "x-inspectra": {
    "artifactSource": "crawled-from-help",
    "generator": "InSpectra.Gen",
    "helpDocumentCount": 1
  },
  "commands": [
    {
      "name": "approve",
      "hidden": false,
      "description": "force the staged diff through (you only)"
    },
    {
      "name": "check",
      "hidden": false,
      "description": "git pre-commit hook entry point"
    },
    {
      "name": "doctor",
      "hidden": false,
      "description": "check the installation"
    },
    {
      "name": "gate",
      "hidden": false,
      "description": "PreToolUse hook entry point (reads the hook JSON on stdin)"
    },
    {
      "name": "init",
      "hidden": false,
      "description": "enable Kaldor in this repository"
    },
    {
      "name": "intent",
      "hidden": false,
      "commands": [
        {
          "name": "amend",
          "hidden": false,
          "description": "propose a change to the frozen intent (the agent)",
          "options": [
            {
              "name": "--accept",
              "recursive": false,
              "hidden": false
            }
          ],
          "arguments": [
            {
              "name": "TEXT",
              "required": true,
              "hidden": false,
              "arity": {
                "minimum": 1,
                "maximum": 1
              }
            }
          ]
        },
        {
          "name": "confirm",
          "hidden": false,
          "description": "confirm the frozen intent; commits wait for it (you only)"
        },
        {
          "name": "freeze",
          "hidden": false,
          "description": "freeze .kaldor/intent.md (the agent runs it)"
        },
        {
          "name": "wait",
          "hidden": false,
          "description": "wait until the user confirms the intent (the agent; default 540 s)",
          "options": [
            {
              "name": "--timeout",
              "recursive": false,
              "hidden": false,
              "arguments": [
                {
                  "name": "TIMEOUT",
                  "required": false,
                  "arity": {
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "report",
      "hidden": false,
      "description": "latest reviews at intent level (default 10)",
      "arguments": [
        {
          "name": "COUNT",
          "required": false,
          "hidden": false,
          "arity": {
            "minimum": 0,
            "maximum": 1
          }
        }
      ]
    },
    {
      "name": "review",
      "hidden": false,
      "description": "dry-run review of the staged diff, nothing recorded"
    }
  ]
}
