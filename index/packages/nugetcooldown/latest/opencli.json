{
  "opencli": "0.1-draft",
  "info": {
    "title": "nuget-cooldown — fail the build when a NuGet package version is younger than N days.",
    "version": "1.1.0",
    "description": "Dependency cooldown for NuGet: fail the build when any resolved package version — direct or transitive — is younger than N days. Malicious package versions are usually detected and removed within days of publication; a cooldown window means your builds never resolve them. Checks project.assets.json against NuGet publish dates, flags unlisted (withdrawn) versions, supports allow lists, JSON output for CI, and an offline cache. Companion package NuGetCooldown.MSBuild enforces the policy automatically on every build."
  },
  "x-inspectra": {
    "artifactSource": "crawled-from-help",
    "generator": "InSpectra.Gen",
    "helpDocumentCount": 4,
    "cliParsedDescription": "Newly published package versions are where supply-chain attacks live: malicious\nuploads are usually detected and removed within days. A cooldown window means\nyour restored dependency graph never contains a version younger than N days."
  },
