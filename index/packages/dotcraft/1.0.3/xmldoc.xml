<?xml version="1.0" encoding="utf-8"?>
<Model>
  <!--NEW-->
  <Command Name="new" IsBranch="true" 
Settings="Spectre.Console.Cli.CommandSettings">
    <Description>Cria novos recursos</Description>
    <!--SOLUTION-->
    <Command Name="solution" IsBranch="false" 
ClrType="DotCraft.Cli.Commands.New.NewSolutionCommand" 
Settings="DotCraft.Cli.Commands.New.NewSolutionSettings">
      <Description>Gera uma nova solução .NET</Description>
      <Parameters>
        <Option Short="a" Long="architecture" Value="ARCHITECTURE" 
Required="false" Kind="scalar" ClrType="System.String">
          <Description>Arquitetura da solução: clean | vertical</Description>
        </Option>
        <Option Short="d" Long="db" Value="DATABASE" Required="false" 
Kind="scalar" ClrType="System.String">
          <Description>Banco de dados: sqlsever | postgres | 
oracle</Description>
        </Option>
        <Option Short="" Long="docs" Value="DOCS" Required="false" Kind="scalar"
ClrType="System.String">
          <Description>Documentação da API: swagger | scalar</Description>
        </Option>
        <Option Short="" Long="format" Value="FORMAT" Required="false" 
Kind="scalar" ClrType="System.String">
          <Description>Formato do projeto: sln | slnx</Description>
        </Option>
        <Option Short="n" Long="name" Value="NAME" Required="false" 
Kind="scalar" ClrType="System.String">
          <Description>Nome da solução</Description>
        </Option>
        <Option Short="" Long="tests" Value="TESTS" Required="false" 
Kind="scalar" ClrType="System.String">
          <Description>Tipo de testes: acceptance | integration | all | 
none</Description>
        </Option>
        <Option Short="v" Long="version" Value="VERSION" Required="false" 
Kind="scalar" ClrType="System.String">
          <Description>Versão do .NET usada: 9 | 10</Description>
        </Option>
      </Parameters>
    </Command>
  </Command>
</Model>