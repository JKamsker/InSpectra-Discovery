    <Parameters>
      <Argument Name="identifier" Position="0" Required="false" Kind="scalar" 
ClrType="System.String" />
    </Parameters>
    <Examples>
      <Example commandLine="upgrade" />
      <Example commandLine="upgrade" />
      <Example commandLine="21.0.2.13-tem" />
    </Examples>
  </Command>
