ClrType="System.Boolean" />
      <Option Short="" Long="temp" Value="NULL" Required="false" Kind="flag" 
ClrType="System.Boolean" />
    </Parameters>
    <Examples>
      <Example commandLine="flush" />
      <Example commandLine="--catalog" />
      <Example commandLine="flush" />
      <Example commandLine="--temp" />
      <Example commandLine="--archives" />
    </Examples>
  </Command>
