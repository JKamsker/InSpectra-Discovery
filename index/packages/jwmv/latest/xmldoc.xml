  <!--ENV-->
  <Command Name="env" IsBranch="false" ClrType="Jwmv.Cli.Commands.EnvCommand" 
Settings="Jwmv.Cli.Commands.EnvCommand+Settings">
    <Description>Prints project activation scripts or the PowerShell profile 
