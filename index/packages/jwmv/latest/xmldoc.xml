<?xml version="1.0" encoding="utf-8"?>
<Model>
  <!--LIST-->
  <Command Name="list" IsBranch="false" ClrType="Jwmv.Cli.Commands.ListCommand" 
Settings="Jwmv.Cli.Commands.ListCommand+Settings">
    <Description>Lists available Java distributions and local 
installations.</Description>
    <Parameters>
      <Argument Name="filter" Position="0" Required="false" Kind="scalar" 
ClrType="System.String" />
      <Option Short="r" Long="refresh" Value="NULL" Required="false" Kind="flag"
ClrType="System.Boolean" />
    </Parameters>
    <Examples>
      <Example commandLine="list" />
      <Example commandLine="list" />
      <Example commandLine="21-tem" />
      <Example commandLine="list" />
      <Example commandLine="--refresh" />
    </Examples>
  </Command>
  <!--INSTALL-->
  <Command Name="install" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.InstallCommand" 
Settings="Jwmv.Cli.Commands.InstallCommand+Settings">
    <Description>Installs a Java distribution by alias or fuzzy 
identifier.</Description>
    <Parameters>
      <Argument Name="identifier" Position="0" Required="false" Kind="scalar" 
ClrType="System.String" />
      <Option Short="d" Long="default" Value="NULL" Required="false" Kind="flag"
ClrType="System.Boolean" />
      <Option Short="r" Long="refresh" Value="NULL" Required="false" Kind="flag"
ClrType="System.Boolean" />
    </Parameters>
    <Examples>
      <Example commandLine="install" />
      <Example commandLine="21-tem" />
      <Example commandLine="install" />
      <Example commandLine="21.0.4-tem" />
      <Example commandLine="--default" />
    </Examples>
  </Command>
  <!--UNINSTALL-->
  <Command Name="uninstall" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.UninstallCommand" 
Settings="Jwmv.Cli.Commands.UninstallCommand+Settings">
    <Description>Removes an installed Java version.</Description>
    <Parameters>
      <Argument Name="identifier" Position="0" Required="false" Kind="scalar" 
ClrType="System.String" />
    </Parameters>
    <Examples>
      <Example commandLine="uninstall" />
      <Example commandLine="uninstall" />
      <Example commandLine="21.0.4.7-tem" />
    </Examples>
  </Command>
  <!--INSTALLED-->
  <Command Name="installed" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.InstalledCommand" 
Settings="Jwmv.Cli.Commands.InstalledCommand+Settings">
    <Description>Shows only the Java versions installed on this 
machine.</Description>
    <Examples>
      <Example commandLine="installed" />
    </Examples>
  </Command>
  <!--USE-->
  <Command Name="use" IsBranch="false" ClrType="Jwmv.Cli.Commands.UseCommand" 
Settings="Jwmv.Cli.Commands.UseCommand+Settings">
    <Description>Emits a PowerShell activation script for a session-local Java 
switch.</Description>
    <Parameters>
      <Argument Name="identifier" Position="0" Required="true" Kind="scalar" 
ClrType="System.String" />
      <Option Short="" Long="shell" Value="SHELL" Required="false" Kind="scalar"
ClrType="System.String" />
    </Parameters>
    <Examples>
      <Example commandLine="use" />
      <Example commandLine="21-tem" />
      <Example commandLine="use" />
      <Example commandLine="21-tem" />
      <Example commandLine="--shell" />
      <Example commandLine="powershell" />
    </Examples>
  </Command>
  <!--DEFAULT-->
  <Command Name="default" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.DefaultCommand" 
Settings="Jwmv.Cli.Commands.DefaultCommand+Settings">
    <Description>Sets the default Java version for new Windows 
sessions.</Description>
    <Parameters>
      <Argument Name="identifier" Position="0" Required="true" Kind="scalar" 
ClrType="System.String" />
    </Parameters>
    <Examples>
      <Example commandLine="default" />
      <Example commandLine="21-tem" />
    </Examples>
  </Command>
  <!--CURRENT-->
  <Command Name="current" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.CurrentCommand" 
Settings="Jwmv.Cli.Commands.CurrentCommand+Settings">
    <Description>Shows the currently active Java resolution.</Description>
    <Examples>
      <Example commandLine="current" />
    </Examples>
  </Command>
  <!--DOCTOR-->
  <Command Name="doctor" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.DoctorCommand" 
Settings="Jwmv.Cli.Commands.DoctorCommand+Settings">
    <Description>Inspects PATH, JAVA_HOME, PowerShell integration, and Java 
command precedence.</Description>
    <Examples>
      <Example commandLine="doctor" />
    </Examples>
  </Command>
