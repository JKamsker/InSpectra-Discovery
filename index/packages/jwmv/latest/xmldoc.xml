    <Parameters>
      <Option Short="" Long="cwd" Value="PATH" Required="false" Kind="scalar" 
ClrType="System.String" />
      <Option Short="" Long="init" Value="NULL" Required="false" Kind="flag" 
ClrType="System.Boolean" />
      <Option Short="" Long="shell" Value="SHELL" Required="false" Kind="scalar"
ClrType="System.String" />
    </Parameters>
    <Examples>
      <Example commandLine="env" />
      <Example commandLine="env" />
      <Example commandLine="--init" />
      <Example commandLine="env" />
      <Example commandLine="--shell" />
      <Example commandLine="powershell" />
    </Examples>
  </Command>
  <!--INTEGRATE-->
  <Command Name="integrate" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.IntegrateCommand" 
Settings="Jwmv.Cli.Commands.IntegrateCommand+Settings">
    <Description>Writes the PowerShell bootstrap into your profile so jwmv works
like a shell function.</Description>
    <Parameters>
      <Option Short="" Long="profile" Value="PATH" Required="false" 
Kind="scalar" ClrType="System.String" />
      <Option Short="" Long="shell" Value="SHELL" Required="false" Kind="scalar"
ClrType="System.String" />
    </Parameters>
    <Examples>
      <Example commandLine="integrate" />
      <Example commandLine="integrate" />
      <Example commandLine="--profile" />
      <Example 
commandLine="C:\Users\me\Documents\PowerShell\Microsoft.PowerShell_profile.ps1" 
/>
    </Examples>
  </Command>
  <!--UPDATE-->
  <Command Name="update" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.UpdateCommand" 
Settings="Jwmv.Cli.Commands.UpdateCommand+Settings">
    <Description>Refreshes the local Foojay catalog cache.</Description>
    <Examples>
      <Example commandLine="update" />
    </Examples>
  </Command>
  <!--SELFUPDATE-->
  <Command Name="selfupdate" IsBranch="false" 
ClrType="Jwmv.Cli.Commands.SelfUpdateCommand" 
Settings="Jwmv.Cli.Commands.SelfUpdateCommand+Settings">
    <Description>Updates jwmv from the latest GitHub Release for this 
architecture.</Description>
    <Parameters>
      <Option Short="c" Long="check" Value="NULL" Required="false" Kind="flag" 
ClrType="System.Boolean" />
      <Option Short="f" Long="force" Value="NULL" Required="false" Kind="flag" 
ClrType="System.Boolean" />
      <Option Short="r" Long="repository" Value="OWNER/REPO" Required="false" 
Kind="scalar" ClrType="System.String" />
      <Option Short="" Long="restart" Value="NULL" Required="false" Kind="flag" 
ClrType="System.Boolean" />
      <Option Short="t" Long="tag" Value="TAG" Required="false" Kind="scalar" 
ClrType="System.String" />
      <Option Short="y" Long="yes" Value="NULL" Required="false" Kind="flag" 
ClrType="System.Boolean" />
    </Parameters>
    <Examples>
      <Example commandLine="selfupdate" />
      <Example commandLine="--check" />
      <Example commandLine="selfupdate" />
      <Example commandLine="--repository" />
      <Example commandLine="owner/repo" />
    </Examples>
  </Command>
