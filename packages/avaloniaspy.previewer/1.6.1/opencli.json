{"opencli":"0.1-draft","info":{"title":"AvaloniaSpy.Previewer","version":"1.6.1","description":"Standalone headless Avalonia process for previewing .axaml files via the AvaloniaSpy MCP server. Renders a single XAML file offscreen using Skia and exposes it through the AvaloniaSpy diagnostic protocol."},"x-inspectra":{"artifactSource":"crawled-from-help","generator":"InSpectra.Gen","helpDocumentCount":1,"cliParsedTitle":"avalonia-spy-previewer"},"commands":[],"options":[{"name":"--project-dir","recursive":false,"hidden":false,"description":"Avalonia project root directory","arguments":[{"name":"PATH","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--axaml","recursive":false,"hidden":false,"description":".axaml file to preview (absolute or relative to project-dir)","arguments":[{"name":"PATH","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--port","recursive":false,"hidden":false,"description":"TCP port for MCP connection","arguments":[{"name":"N","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--assembly","recursive":false,"hidden":false,"description":"Path to compiled project DLL (auto-discovered from bin/ if omitted)","arguments":[{"name":"PATH","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--width","recursive":false,"hidden":false,"description":"Offscreen canvas width (default 1280)","arguments":[{"name":"N","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--height","recursive":false,"hidden":false,"description":"Offscreen canvas height (default 720)","arguments":[{"name":"N","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--theme","recursive":false,"hidden":false,"description":"'fluent' (default), 'simple', 'none'","arguments":[{"name":"NAME","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show this help","aliases":["-h"]}]}