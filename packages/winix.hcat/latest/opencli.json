{"opencli":"0.1-draft","info":{"title":"hcat","version":"0.4.0","description":"HTTP toolkit — netcat for HTTP: inspect/record requests, pipe paths to a CLI, or serve files. One binary, no daemon."},"x-inspectra":{"artifactSource":"crawled-from-help","generator":"InSpectra.Gen","helpDocumentCount":1},"commands":[],"options":[{"name":"--lan","recursive":false,"hidden":false,"description":"Bind 0.0.0.0 to share on the local network (prints a QR code)."},{"name":"--local","recursive":false,"hidden":false,"description":"Force loopback-only binding (overrides --lan/--host)."},{"name":"--https","recursive":false,"hidden":false,"description":"Enable TLS with an in-memory self-signed certificate."},{"name":"--upload","recursive":false,"hidden":false,"description":"(serve) Enable the POST upload receiver."},{"name":"--spa","recursive":false,"hidden":false,"description":"(serve) SPA fallback: unmatched browser navigations return the index file."},{"name":"--spa-index","recursive":false,"hidden":false,"description":"(serve, with --spa) SPA fallback filename (default index.html).","arguments":[{"name":"FILE","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--host","recursive":false,"hidden":false,"description":"Explicit bind address.","arguments":[{"name":"ADDR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--port","recursive":false,"hidden":false,"description":"Listen port (default 8080).","arguments":[{"name":"N","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--upload-dir","recursive":false,"hidden":false,"description":"(serve) Upload target directory (default ./uploads).","arguments":[{"name":"DIR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--status","recursive":false,"hidden":false,"description":"(inspect) HTTP status to respond with (default 200).","arguments":[{"name":"CODE","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--capture","recursive":false,"hidden":false,"description":"(CI) Exit after capturing N requests.","arguments":[{"name":"N","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--exit-on","recursive":false,"hidden":false,"description":"(CI) Exit when a request matches: path=/x, method=POST, body~text (body~ is inspect-only).","arguments":[{"name":"EXPR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--timeout","recursive":false,"hidden":false,"description":"(CI) Fail if the stop condition is not met within DUR (e.g. 30s, 5m).","arguments":[{"name":"DUR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help","aliases":["-h"]},{"name":"--version","recursive":false,"hidden":false,"description":"Show version"},{"name":"--no-color","recursive":false,"hidden":false,"description":"Disable colored output"},{"name":"--json","recursive":false,"hidden":false,"description":"JSON output"},{"name":"--describe","recursive":false,"hidden":false,"description":"Structured JSON metadata for AI agents"},{"name":"--color","recursive":false,"hidden":false,"description":"Coloured output: auto (default when omitted), always, or never"}]}