"-h"]}]},{"name":"logout","hidden":false,"description":"Remove the cached token for the active base URL.","options":[{"name":"--base-url","recursive":false,"hidden":false,"description":"API base URL (default: $DEVORCH_API_BASE or http://localhost:8700).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}]},{"name":"mcp","hidden":false,"options":[{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}],"commands":[{"name":"serve","hidden":false,"description":"Run the MCP server. Default: stdio + full profile (reads + execution-writes + driver-control). --profile run-agent: subtractive minimal (Read + Execution only). --profile driver: + driver-control loop verbs. --allow-admin (alias --allow-control): + type/config CRUD (full only). --explore: + generic entity tools (full only). --http: remote Streamable-HTTP.","options":[{"name":"--base-url","recursive":false,"hidden":false,"description":"API base URL (default: $DEVORCH_API_BASE or http://localhost:8700).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--allow-admin","recursive":false,"hidden":false,"description":"Also expose admin-write tools (type/config CRUD, project.manage). Off by default. Reads + the run agent's execution-writes are always on regardless of this flag."},{"name":"--allow-control","recursive":false,"hidden":false,"description":"Deprecated back-compat alias for --allow-admin (the old binary control gate). Prefer --allow-admin."},{"name":"--explore","recursive":false,"hidden":false,"description":"Also expose the generic entity 'explore' tools (list_resources/get_resource/list_types/get_type). Off by default — not the run agent's loadout."},{"name":"--http","recursive":false,"hidden":false,"description":"Serve over remote Streamable-HTTP instead of stdio (each request authenticates with its own bearer)."},{"name":"--profile","recursive":false,"hidden":false,"description":"Loadout profile: full (default — operator toolbelt incl. driver-control + flagged admin/explore), run-agent (subtractive minimal: Read + Execution only, excludes the program-counter verbs), or driver (Read + Execution + driver-control loop verbs). (Default: full)","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--port","recursive":false,"hidden":false,"description":"Port for the http transport (default 8701). (Default: 8701)","arguments":[{"name":"INT32","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}]}]},{"name":"projects","hidden":false,"options":[{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}],"commands":[{"name":"list","hidden":false,"description":"List all work items: GET /api/work-items.","options":[{"name":"--base-url","recursive":false,"hidden":false,"description":"API base URL (default: $DEVORCH_API_BASE or http://localhost:8700).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}]},{"name":"show","hidden":false,"description":"Show one work item's detail + stage rollup: GET /api/work-items/{slug}.","options":[{"name":"--base-url","recursive":false,"hidden":false,"description":"API base URL (default: $DEVORCH_API_BASE or http://localhost:8700).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}]}]},{"name":"rollup","hidden":false,"description":"Cross-project rollup summary: GET /api/rollup.","options":[{"name":"--base-url","recursive":false,"hidden":false,"description":"API base URL (default: $DEVORCH_API_BASE or http://localhost:8700).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}]},{"name":"run","hidden":false,"options":[{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}],"commands":[{"name":"abort","hidden":false,"description":"Operator stop: reap any tracked headless children for this process (best-effort).","options":[{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}]},{"name":"drive","hidden":false,"description":"Drive a run: fetch typed instructions and branch on `control` (execute_step / evaluate / record_backedge). --once: one step. --fixture FILE + --dry-run: fully offline state-machine exercise. --billing api_key keeps ANTHROPIC_API_KEY (default subscription strips it). CREDENTIAL: a `devorch login` token is short-lived (~1h) and is NOT auto-refreshed - a run that outlives it exits 77 (auth). For unattended runs use a long-lived Personal Access Token (create at /app/account/tokens, save as access_token in ~/.devorch/token.json).","options":[{"name":"--base-url","recursive":false,"hidden":false,"description":"API base URL (default: $DEVORCH_API_BASE or http://localhost:8700).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--once","recursive":false,"hidden":false,"description":"Run exactly one step (same code path as the loop) and stop."},{"name":"--max-steps","recursive":false,"hidden":false,"description":"Hard cap on iterations (runaway guard); --once implies 1. (Default: 60)","arguments":[{"name":"INT32","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--max-consecutive-failures","recursive":false,"hidden":false,"description":"Stop after this many back-to-back failures (reset on success). (Default: 2)","arguments":[{"name":"INT32","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--max-wait-polls","recursive":false,"hidden":false,"description":"Stop after this many CONSECUTIVE WAIT polls (parking bound; separate from --max-steps, reset by progress). (Default: 60)","arguments":[{"name":"INT32","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--model","recursive":false,"hidden":false,"description":"Model override for harness dispatch.","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--dry-run","recursive":false,"hidden":false,"description":"Mock dispatch (no claude): post canned successful results."},{"name":"--fixture","recursive":false,"hidden":false,"description":"Replay next-instruction envelopes from a local JSON file (offline; results captured, not sent).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--billing","recursive":false,"hidden":false,"description":"Billing mode: subscription (default, strips ANTHROPIC_API_KEY) or api_key.","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--emit-bodies","recursive":false,"hidden":false,"description":"(fixture) write the captured result bodies as a JSON array to this file (the conformance corpus sink).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--no-notify","recursive":false,"hidden":false,"description":"Suppress the terminal-state PushNotification."},{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}]},{"name":"step","hidden":false,"description":"HAND CRANK: push the program counter one step at a time, by hand, and see what the engine did with it. Prints each instruction envelope, waits for a keystroke ([Enter]=report success, f=reject the gate, b=raise a blocker, x=report a malformed result, p=peek, q=stop), then re-reads GET /position and prints the delta - the ENGINE's answer, never the tool's claim. Writes a 3-file transcript; the .canonical.json is redacted + key-sorted so two identical sessions diff to NOTHING. --script replays keys with no human (the regression gate: re-run after an engine change and diff the canonical file against the accepted one).","options":[{"name":"--base-url","recursive":false,"hidden":false,"description":"API base URL (default: $DEVORCH_API_BASE or http://localhost:8700).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--transcript-dir","recursive":false,"hidden":false,"description":"Directory for the 3-file transcript (default: ./hand-crank).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--name","recursive":false,"hidden":false,"description":"Transcript base name (default: crank-<run-prefix>-<utc stamp>). Pass a FIXED name to overwrite an accepted baseline in place.","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--script","recursive":false,"hidden":false,"description":"Replay keys with no human: a comma/space-separated list (e.g. \",,f,,x,q\" - an empty item is [Enter]) or @path to a file with one key per line.","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--max-steps","recursive":false,"hidden":false,"description":"Hard cap on iterations (runaway guard). (Default: 60)","arguments":[{"name":"INT32","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["-h"]}]},{"name":"supervise","hidden":false,"description":"Restart-safe wrapper around `run drive`: re-launch on a TRANSIENT death (backend unreachable), STOP on a LOGICAL terminal (DONE / ABORT / a real ESCALATE) or an AUTH failure (exit 77 - a re-launch cannot fix a rejected credential). CREDENTIAL: prefer a long-lived PAT (create at /app/account/tokens, save as access_token in ~/.devorch/token.json); a `devorch login` token expires in ~1h and is NOT refreshed, so any longer run will die on it.","options":[{"name":"--max-restarts","recursive":false,"hidden":false,"description":"Max transient (backend-unreachable) re-launches before giving up (0 = one shot). (Default: 20)","arguments":[{"name":"INT32","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--restart-backoff","recursive":false,"hidden":false,"description":"Base seconds before a transient re-launch (doubles each consecutive transient death, capped). (Default: 2)","arguments":[{"name":"DOUBLE","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--restart-backoff-cap","recursive":false,"hidden":false,"description":"Cap on the transient re-launch backoff. (Default: 30)","arguments":[{"name":"DOUBLE","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--model","recursive":false,"hidden":false,"description":"(driver) model override.","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--max-steps","recursive":false,"hidden":false,"description":"(driver) hard cap on iterations per launch.","arguments":[{"name":"INT32","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--max-consecutive-failures","recursive":false,"hidden":false,"description":"(driver) stop after this many back-to-back failures.","arguments":[{"name":"INT32","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--dry-run","recursive":false,"hidden":false,"description":"(driver) mock dispatch (no claude) - lets the supervisor be mock-tested."},{"name":"--no-notify","recursive":false,"hidden":false,"description":"(driver) suppress the terminal-state PushNotification."},{"name":"--fixture","recursive":false,"hidden":false,"description":"(driver) replay envelopes from a local JSON file (offline).","arguments":[{"name":"STRING","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help message","aliases":["