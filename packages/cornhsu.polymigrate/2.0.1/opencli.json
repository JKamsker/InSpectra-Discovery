{"name":"--root","recursive":false,"hidden":false,"arguments":[{"name":"DIR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--out","recursive":false,"hidden":false,"arguments":[{"name":"FILE","required":true,"arity":{"minimum":1,"maximum":1}}]}]},{"name":"thumbs","hidden":false,"options":[{"name":"--root","recursive":false,"hidden":false,"arguments":[{"name":"DIR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--media","recursive":false,"hidden":false,"arguments":[{"name":"DIR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--out","recursive":false,"hidden":false,"arguments":[{"name":"DIR","required":true,"arity":{"minimum":1,"maximum":1}}]}],"arguments":[{"name":"CONFIGYAML","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}}]},{"name":"verify","hidden":false,"options":[{"name":"--media","recursive":false,"hidden":false,"arguments":[{"name":"DIR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--media-prefix","recursive":false,"hidden":false,"arguments":[{"name":"MEDIA_PREFIX","required":false,"arity":{"minimum":0,"maximum":1}}]},{"name":"/media","recursive":false,"hidden":false}],"arguments":[{"name":"OUTPUT_DIR","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}}]}],"options":[{"name":"--dry-run","recursive":false,"hidden":false,"description":"polymigrate thumbs <config.yaml> [--root <dir>] [--media <dir>] [--out <dir>]\nGenerate thumbnails: media/ -> media_thumb/ (same layout). EXIF auto-orient,\ndownscale to media.thumbnails.max_width. Existing thumbnails are skipped.\npolymigrate probe-orphans <config.yaml> --section <name> --years <from-to>\n[--lang <prefix>] [--root <dir>] [--out <file>]\nProbe the live site for orphan pages (removed from indexes but still served):\nper-day slugs in both YYYYMMDD and MMDDYYYY forms, plus A-D suffix variants.\nPolite (site.polite.delay_ms) and sends site.auth_workaround cookies.\npolymigrate fetch-orphans <config.yaml> --section <name> [--slugs <file>] [--root <dir>]\nFetch probed orphan pages (all langs) into raw/ and their assets into media/.\npolymigrate verify <output-dir> [--media <dir>] [--media-prefix /media/]\nVerify extracted output: frontmatter fields, internal links, media refs.\nDefault media dir: <output-dir>/media (media checks skipped if absent).\npolymigrate --version               Print version"}],"arguments":[{"name":"ROOT","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}},{"name":"OUTPUT_DIR","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}}]}