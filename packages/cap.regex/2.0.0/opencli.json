{"opencli":"0.1-draft","info":{"title":"regex","version":"2.0.0","description":"Regex command for the commandline."},"x-inspectra":{"artifactSource":"startup-hook","generator":"InSpectra.Gen","hookCapture":{"cliFramework":"System.CommandLine","frameworkVersion":"2.0.12.0","systemCommandLineVersion":"2.0.12.0","patchTarget":"Parse-postfix ()"},"cliFramework":"System.CommandLine","cliParsedDescription":"regex is a CLI frontend for the .NET Regular Expression Engine.\nIt searches for a given search pattern in the file contents of every given input file.\nOptionally you can set a replace pattern that will be applied on every match.\n\nExamples:\n  regex \"Name:(?<name>[A-Za-z]+)\" --replace \"id=${name}\" names.txt\n  regex --recursive --filter *.txt Hello ./"},"options":[{"name":"--help","recursive":true,"hidden":false,"description":"Show help and usage information","aliases":["-h","/h","-?","/?"]},{"name":"--replace","recursive":false,"hidden":false,"description":"replacement Pattern (regex)","aliases":["-R"],"arguments":[{"name":"REPLACE","required":true,"arity":{"minimum":1,"maximum":1},"type":"String"}]},{"name":"--case-sensitive","recursive":false,"hidden":false,"description":"enables case-sensitive behavior - btw. disables the by default enabled ignore-case option [default: False]","aliases":["-c"],"arguments":[{"name":"CASE_SENSITIVE","required":false,"arity":{"minimum":0,"maximum":1},"type":"Boolean"}]},{"name":"--filter","recursive":false,"hidden":false,"description":"wildcard based file filter, e.g. *.txt [default: *.*]","aliases":["-f"],"arguments":[{"name":"FILTER","required":true,"arity":{"minimum":1,"maximum":1},"type":"String"}]},{"name":"--recursive","recursive":false,"hidden":false,"description":"progress all subdirectories [default: False]","aliases":["-r"],"arguments":[{"name":"RECURSIVE","required":false,"arity":{"minimum":0,"maximum":1},"type":"Boolean"}]},{"name":"--offset-width","recursive":false,"hidden":false,"description":"output-formatting: set the count of characters used for the offset column [default: 6]","arguments":[{"name":"OFFSET_WIDTH","required":true,"arity":{"minimum":1,"maximum":1},"type":"Int32"}]},{"name":"--only-matching","recursive":false,"hidden":false,"description":"prints only the match [default: False]","aliases":["-o"],"arguments":[{"name":"ONLY_MATCHING","required":false,"arity":{"minimum":0,"maximum":1},"type":"Boolean"}]},{"name":"--max-count","recursive":false,"hidden":false,"description":"limit matches to the given count","aliases":["-m"],"arguments":[{"name":"MAX_COUNT","required":true,"arity":{"minimum":1,"maximum":1},"type":"Int32"}]},{"name":"--verbose","recursive":false,"hidden":false,"description":"show additional information [default: False]","aliases":["-v"],"arguments":[{"name":"VERBOSE","required":false,"arity":{"minimum":0,"maximum":1},"type":"Boolean"}]},{"name":"--version","recursive":false,"hidden":false,"description":"show version information [default: False]","aliases":["-V"],"arguments":[{"name":"VERSION","required":false,"arity":{"minimum":0,"maximum":1},"type":"Boolean"}]}],"arguments":[{"name":"PATTERN","description":"The search pattern as .NET Regular Expression (RegEx).","required":false,"arity":{"minimum":0,"maximum":1},"type":"String"},{"name":"PATH","description":"File or directory to operate. (A directory must end with a directory separator)","required":false,"arity":{"minimum":0,"maximum":100000},"type":"String[]"}]}