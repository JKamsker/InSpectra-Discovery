{"opencli":"0.1-draft","info":{"title":"ezgdal — portable GDAL CLI","version":"1.0.0","description":"One-binary, portable GDAL CLI. Supports legacy EXE names (gdalinfo, gdal_translate, gdalwarp, ogr2ogr, ogrinfo, ...) plus the GDAL 3.12+ unified `gdal` CLI. After install, run `ezgdal install-applets` to expose legacy EXE-name symlinks. Native binaries for linux-x64."},"x-inspectra":{"artifactSource":"crawled-from-help","generator":"InSpectra.Gen","helpDocumentCount":1,"cliParsedTitle":"ezgdal: unknown subcommand '--help'."},"commands":[],"arguments":[{"name":"DATASET","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}},{"name":"INFO","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}},{"name":"MDIM","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}},{"name":"PIPELINE","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}},{"name":"RASTER","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}},{"name":"VECTOR","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}},{"name":"VSI","required":true,"hidden":false,"arity":{"minimum":1,"maximum":1}}]}