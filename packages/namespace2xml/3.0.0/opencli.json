{"opencli":"0.1-draft","info":{"title":"namespace2xml - deterministic configuration transformer.","version":"3.0.0","description":"Deterministic configuration transformer. Merges and templates namespace profiles into XML, JSON, YAML, INI and shell outputs from a single normative specification. Every diagnostic carries a stable code and a specification anchor, and --diagnostics-format json makes the whole diagnostic stream machine-readable for automation and AI agents."},"x-inspectra":{"artifactSource":"crawled-from-help","generator":"InSpectra.Gen","helpDocumentCount":1,"cliParsedDescription":"Reads ordered namespace profiles, JSON, YAML and XML inputs, applies scheme\ndirectives, and renders namespace, shell-quoted namespace, JSON, YAML, XML and\nINI outputs. Identical inputs always produce byte-identical outputs."},"commands":[],"options":[{"name":"--input","recursive":false,"hidden":false,"description":"Ordered input file paths.","aliases":["-i"],"arguments":[{"name":"PATH","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--scheme","recursive":false,"hidden":false,"description":"Ordered scheme file paths.","aliases":["-s"],"arguments":[{"name":"PATH","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--output","recursive":false,"hidden":false,"description":"Output root directory. Default: current","aliases":["-o"],"arguments":[{"name":"DIR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--variables","recursive":false,"hidden":false,"description":"Namespace entries applied after all input","aliases":["-v"],"arguments":[{"name":"ENTRY","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--verbosity","recursive":false,"hidden":false,"description":"trace|debug|information|warning|error|critical|none.","arguments":[{"name":"LEVEL","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--diagnostics-format","recursive":false,"hidden":false,"description":"text|json. Default: text. 'json' writes","arguments":[{"name