{"opencli":"0.1-draft","info":{"title":"AngelSix ContextMap CLI","version":"1.2.0","description":"The gated, on-demand companion to the AngelSix.ContextMap on-build package. Opens a .NET solution with Roslyn and writes a full context map including the in-solution call graph (who calls what) into AgentDocumentation/ContextMap, the evidence behind a context map's \"touch X also touch Y\" impact guidance. Slower than the on-build structural pass, so it is run on demand, not every build."},"x-inspectra":{"artifactSource":"crawled-from-help","generator":"InSpectra.Gen","helpDocumentCount":1,"cliFramework":"System.CommandLine"},"commands":[{"name":"callgraph","hidden":false,"options":[{"name":"--solution","recursive":false,"hidden":false,"arguments":[{"name":"SLNSLNXCSPROJ","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--output","recursive":false,"hidden":false,"arguments":[{"name":"DIR","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--include-internal","recursive":false,"hidden":false,"arguments":[{"name":"INCLUDE_INTERNAL","required":false,"arity":{"minimum":0,"maximum":1}}]},{"name":"--exclude","recursive":false,"hidden":false,"arguments":[{"name":"EXCLUDE","required":false,"arity":{"minimum":0,"maximum":1}}]}]},{"name":"impact","hidden":false,"options":[{"name":"--member","recursive":false,"hidden":false,"arguments":[{"name":"TYPEMETHODNAME","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--solution","recursive":false,"hidden":false,"arguments":[{"name":"SLNSLNXCSPROJ","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--map","recursive":false,"hidden":false,"arguments":[{"name":"STRUCTUREJSON","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--direction","recursive":false,"hidden":false},{"name":"--depth","recursive":false,"hidden":false,"arguments":[{"name":"N","required":true,"arity":{"minimum":1,"maximum":1}}]}]}]}