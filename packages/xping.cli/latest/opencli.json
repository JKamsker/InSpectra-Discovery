{"opencli":"0.1-draft","info":{"title":"Xping.Cli","version":"1.0.0-rc.5","description":"Command-line companion for the Xping SDK. Reads the local run store written by Xping.Sdk.Core and reports test flakiness from recent local runs. No account required."},"x-inspectra":{"artifactSource":"startup-hook","generator":"InSpectra.Gen","hookCapture":{"cliFramework":"System.CommandLine","frameworkVersion":"2.0.10.0","systemCommandLineVersion":"2.0.10.0","patchTarget":"Parse-postfix ()"},"cliFramework":"System.CommandLine","cliParsedDescription":"xping - local test reliability reports\n\nRuns are recorded by the Xping SDK. No account is required."},"options":[{"name":"--help","recursive":true,"hidden":false,"description":"Show help and usage information","aliases":["-h","/h","-?","/?"]},{"name":"--version","recursive":false,"hidden":false,"description":"Show version information"}],"commands":[{"name":"report","description":"Report test reliability findings from recent local runs","options":[{"name":"--runs","recursive":false,"hidden":false,"description":"Recent runs to analyse (default: 20, or 14 days, whichever is fewer)","aliases":["--last"],"arguments":[{"name":"RUNS","required":true,"arity":{"minimum":1,"maximum":1},"type":"Int32"}]},{"name":"--since","recursive":false,"hidden":false,"description":"Analyse from a commit SHA or a date (yyyy-MM-dd)","arguments":[{"name":"SINCE","required":true,"arity":{"minimum":1,"maximum":1},"type":"String"}]},{"name":"--top","recursive":false,"hidden":false,"description":"Findings to show (default 10)","arguments":[{"name":"TOP","required":true,"arity":{"minimum":1,"maximum":1},"type":"Int32"}]},{"name":"--all","recursive":false,"hidden":false,"description":"Show every finding rather than the top ones [default: False]","arguments":[{"name":"ALL","required":false,"arity":{"minimum":0,"maximum":1},"type":"Boolean"}]},{"name":"--kind","recursive":false,"hidden":false,"description":"Restrict to one or more finding kinds","arguments":[{"nam