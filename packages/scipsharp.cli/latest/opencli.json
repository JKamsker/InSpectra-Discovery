nts":[{"name":"PROJECT_ROOT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--output","recursive":false,"hidden":false,"description":"Output file [default: index.scip]","arguments":[{"name":"OUTPUT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}]},{"name":"sql","hidden":false,"description":"SQL (ANSI, PostgreSQL, T-SQL, MySQL, SQLite, PL/SQL) (native, no upstream indexer)","options":[{"name":"--project-root","recursive":false,"hidden":false,"description":"Project directory [default: .]","arguments":[{"name":"PROJECT_ROOT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--output","recursive":false,"hidden":false,"description":"Output file [default: index.scip]","arguments":[{"name":"OUTPUT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}]},{"name":"typescript","hidden":false,"description":"TypeScript, JavaScript (port of scip-typescript)","options":[{"name":"--project-root","recursive":false,"hidden":false,"description":"Project directory [default: .]","arguments":[{"name":"PROJECT_ROOT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--output","recursive":false,"hidden":false,"description":"Output file [default: index.scip]","arguments":[{"name":"OUTPUT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}]},{"name":"vb6","hidden":false,"description":"Visual Basic 6 / VBA (native, no upstream indexer)","options":[{"name":"--project-root","recursive":false,"hidden":false,"description":"Project directory [default: .]","arguments":[{"name":"PROJECT_ROOT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--output","recursive":false,"hidden":false,"description":"Output file [default: index.scip]","arguments":[{"name":"OUTPUT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}]}]},{"name":"lint","hidden":false,"description":"Example usage:\nscip lint /path/to/index.scip\nYou may want to filter the output using `grep -v <pattern>`\nto narrow down on certain classes of errors.","options":[{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}],"arguments":[{"name":"path","required":false,"hidden":false,"arity":{"minimum":0,"maximum":1},"description":"Path to SCIP index file"}]},{"name":"print","hidden":false,"description":"WARNING: The TTY output may change over time.\nDo not rely on non-JSON output in scripts","options":[{"name":"--json","recursive":false,"hidden":false,"description":"Output in JSON format"},{"name":"--color","recursive":false,"hidden":false,"description":"Enable color output for TTY (no effect for JSON) (default: true) [default: true]"},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}],"arguments":[{"name":"path","required":false,"hidden":false,"arity":{"minimum":0,"maximum":1},"description":"Path to SCIP index file"}]},{"name":"snapshot","hidden":false,"description":"The snapshot subcommand generates snapshot files which\ncan be use for inspecting the output of an index in a\nvisual way. Occurrences are marked with caret signs (^)\nand symbol information.\nFor testing a SCIP indexer, you can either use this subcommand\nalong with 'git diff' or equivalent, or you can use the dedicated\n'test' subcommand for more targeted checks.","options":[{"name":"--from","recursive":false,"hidden":false,"description":"Path to SCIP index file [default: index.scip]","arguments":[{"name":"FROM","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--to","recursive":false,"hidden":false,"description":"Path to output directory for snapshot files [default: scip-snapshot]","arguments":[{"name":"TO","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--project-root","recursive":false,"hidden":false,"description":"Override project root in the SCIP file. This can be helpful when the SCIP index was created on another computer","arguments":[{"name":"PROJECT_ROOT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--strict","recursive":false,"hidden":false,"description":"If true, fail fast on errors [default: true]"},{"name":"--comment-syntax","recursive":false,"hidden":false,"description":"Comment syntax to use for snapshot files [default: //]","arguments":[{"name":"COMMENT_SYNTAX","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}]},{"name":"stats","hidden":false,"description":"Output useful statistics about a SCIP index","options":[{"name":"--from","recursive":false,"hidden":false,"description":"Path to SCIP index file [default: index.scip]","arguments":[{"name":"FROM","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--project-root","recursive":false,"hidden":false,"description":"Override project root in the SCIP file. This can be helpful when the SCIP index was created on another computer","arguments":[{"name":"PROJECT_ROOT","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}]},{"name":"test","hidden":false,"description":"Validates whether the SCIP data present in an index\nmatches that specified in human-readable test files, using syntax\nsimilar to the 'snapshot' subcommand. Test file syntax reference:\nhttps://github.com/scip-code/scip/blob/v0.10.0/docs/test_file_format.md\nThe test files are located based on the relative_path field\nin the SCIP document, interpreted relative to the the directory\nthe CLI is invoked in.\nIf you want to instead check all the data in a SCIP index,\nuse the 'snapshot' subcommand.","options":[{"name":"--from","recursive":false,"hidden":false,"description":"Path to SCIP index file [default: index.scip]","arguments":[{"name":"FROM","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--comment-syntax","recursive":false,"hidden":false,"description":"Comment syntax to use for snapshot files [default: //]","arguments":[{"name":"COMMENT_SYNTAX","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--filter","recursive":false,"hidden":false,"description":"Explicit list of test files to check. Can be specified multiple times. If not specified, all files are tested.","aliases":["-f"],"arguments":[{"name":"FILTER","required":true,"arity":{"minimum":1,"maximum":1}}]},{"name":"--check-documents","recursive":false,"hidden":false,"description":"Whether or not to validate whether every file in the test directory has a correlating document in the SCIP index."},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}],"arguments":[{"name":"directory","required":false,"hidden":false,"arity":{"minimum":0,"maximum":1},"description":"Directory containing the test files"}]}],"options":[{"name":"--version","recursive":false,"hidden":false,"description":"print the version","aliases":["-v"]},{"name":"--help","recursive":false,"hidden":false,"description":"Show help and usage information","aliases":["-h"]}]}