{"opencli":"0.1-draft","info":{"title":"CSharp Doctor CLI","version":"0.2.1","description":"Roslyn-based code health scanner for .NET solutions. 57 rules across security, correctness, performance, maintainability, observability, wiring, EF migrations, and ASP.NET Core. Install as a global tool (`dotnet tool install -g CSharpDoctor.Cli`) or run once via `dnx CSharpDoctor.Cli@latest -- .`."},"x-inspectra":{"artifactSource":"startup-hook","generator":"InSpectra.Gen","hookCapture":{"cliFramework":"System.CommandLine","frameworkVersion":"2.0.0.0","systemCommandLineVersion":"2.0.0.0","patchTarget":"Parse-postfix ()"},"cliFramework":"System.CommandLine","cliParsedTitle":"csharp-doctor","cliParsedDescription":"Scan .NET codebases for security, correctness, and performance issues.\n\nSCAN MODES\n  Default: lint only (Roslyn analyzers).\n  --wiring      also detect unregistered services/handlers/validators (slower; whole solution).\n  --ef          also detect unsafe EF Core migrations.\n  --architecture also detect namespace cycles and dead-code heuristics.\n  --sca         also scan NuGet packages for known vulnerabilities.\n  --all-checks  enable everything."},"options":[{"name":"--diff","recursive":false,"hidden":false,"description":"Scan only files changed against base ref","arguments":[{"name":"DIFF","required":true,"arity":{"minimum":1,"maximum":1},"type":"String"}]},{"name":"--staged","recursive":false,"hidden":false,"description":"Scan only staged files","arguments":[{"name":"STAGED","required":false,"arity":{"minimum":0,"maximum":1},"type":"Boolean"}]},{"name":"--project","recursive":false,"hidden":false,"description":"Specific project or solution path","arguments":[{"name":"PROJECT","required":true,"arity":{"minimum":1,"maximum":1},"type":"String"}]},{"name":"--fail-on","recursive":false,"hidden":false,"description":"Exit code gate","arguments":[{"name":"FAIL_ON","required":true,"arity":{"minimum":1,"maximum":1},"type":"FailOnLevel","allowedValues":["Error","Warnin